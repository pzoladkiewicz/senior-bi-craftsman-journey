    <worksheet name='38. Attention'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Regular' fontsize='9'>Attention - Return Rate &gt;20% and Value &gt; £100</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_transactions_classified' name='federated.043zsgd03ajrzj1edwg1s0ln338l' />
          </datasources>
          <datasource-dependencies datasource='federated.043zsgd03ajrzj1edwg1s0ln338l'>
            <column caption='30. CY YTD T|F' datatype='boolean' name='[30. T|F 2011SameMD (copy)_1058345977861468193]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([InvoiceDate]) = YEAR(TODAY())&#13;&#10;AND &#13;&#10;DATE([InvoiceDate]) &lt;= TODAY()' />
            </column>
            <column caption='30. Returns YTD' datatype='real' default-format='c&quot;£&quot;#,##0,.0K;-&quot;£&quot;#,##0,.0K' name='[Calculation_1570348957927321600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [TransactionCategory] = &quot;Returns&quot;&#13;&#10;    AND [30. T|F 2011SameMD (copy)_1058345977861468193]&#13;&#10;THEN [TotalValue]&#13;&#10;END' />
            </column>
            <column caption='32.1 Return Rate' datatype='real' default-format='p0.0%' name='[Calculation_1570348957927583745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='abs(SUM([Calculation_1570348957927321600]) / ZN([Calculation_199002871379718149]))' />
            </column>
            <column caption='35.1 Product Transaction Volume' datatype='integer' name='[Calculation_1570348958287900681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [TransactionCategory] = &quot;ValidSales&quot;&#13;&#10;    THEN [StockCode]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='35.2 Product AOV' datatype='real' default-format='C2057%' name='[Calculation_1570348958288384010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_199002871379718149]&#13;&#10;/&#13;&#10;[Calculation_1570348958287900681]' />
            </column>
            <column caption='ZN([32.1 Return Rate])' datatype='real' name='[Calculation_1570348958313160718]' role='measure' type='quantitative' user:unnamed='Product Performance Matrix'>
              <calculation class='tableau' formula='ZN([Calculation_1570348957927583745])' />
            </column>
            <column caption='ABS(SUM([30. Returns YTD]))' datatype='real' name='[Calculation_1615666432027758592]' role='measure' type='quantitative' user:unnamed='38. Attention'>
              <calculation class='tableau' formula='ABS(SUM([Calculation_1570348957927321600]))' />
            </column>
            <column caption='31.1 Net Revenue per Product' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[Calculation_199002871379718149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [TransactionCategory] = &quot;ValidSales&quot;&#13;&#10;    AND [30. T|F 2011SameMD (copy)_1058345977861468193]&#13;&#10;THEN [TotalValue]&#13;&#10;END)' />
            </column>
