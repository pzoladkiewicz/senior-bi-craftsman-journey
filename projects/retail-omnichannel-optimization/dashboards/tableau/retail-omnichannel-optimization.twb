    <worksheet name='23. KPI Channel Score'>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_sales+' name='federated.1vbucgb1f0or7y11v3r3q02xzapd' />
          </datasources>
          <datasource-dependencies datasource='federated.1vbucgb1f0or7y11v3r3q02xzapd'>
