    <worksheet name='Customers New vs, Returning'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Regular' fontsize='9'>Customer Aquisition &amp; Retention</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_sales+' name='federated.1vbucgb1f0or7y11v3r3q02xzapd' />
          </datasources>
          <datasource-dependencies datasource='federated.1vbucgb1f0or7y11v3r3q02xzapd'>
            <column caption='00. Anchor - 2011SameMD' datatype='date' name='[Calculation_1423981968018972672]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKEDATE(2011, MONTH(TODAY()), DAY(TODAY()))' />
            </column>
            <column caption='06. New Customers YTD' datatype='integer' name='[Calculation_1646347200206495787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    If YEAR([FirstPurchase]) = YEAR([Calculation_1423981968018972672])&#13;&#10;        AND MONTH([FirstPurchase]) = MONTH([Date])&#13;&#10;    THEN [CustomerKey]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='06. Returning Customers YTD' datatype='integer' name='[Calculation_1751055891909840897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF YEAR([Date]) = YEAR([Calculation_1423981968018972672]) AND&#13;&#10;    MONTH([Date]) &lt;= MONTH(TODAY()) AND&#13;&#10;    [Date] &lt;= [Calculation_1423981968018972672]&#13;&#10;THEN&#13;&#10;&#13;&#10;        IF [FirstPurchase] &lt; MAKEDATE(YEAR([Calculation_1423981968018972672]), 1, 1)&#13;&#10;        THEN [CustomerKey]&#13;&#10;        END&#13;&#10;&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='06. % New' datatype='real' default-format='p0.0%' name='[Calculation_1751055891918893063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1646347200206495787] / &#13;&#10;([Calculation_1646347200206495787] + [Calculation_1751055891909840897])' />
            </column>
            <column caption='MIN(1)' datatype='integer' name='[Calculation_1751055891919196170]' role='measure' type='quantitative' user:unnamed='Customers New vs, Returning'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column datatype='integer' name='[CustomerKey]' role='dimension' type='ordinal' />
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='datetime' name='[FirstPurchase]' role='dimension' type='ordinal' />
            <column caption='_2011SameMD' datatype='boolean' name='[_Anchor 2011SameMD (copy)_1646347199960289281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Date] &lt;= MAKEDATE(2011, MONTH(TODAY()), DAY(TODAY()))' />
