            <column caption='06. New Customers YTD' datatype='integer' name='[Calculation_1646347200206495787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    If YEAR([FirstPurchase]) = YEAR([Calculation_1423981968018972672])&#13;&#10;        AND MONTH([FirstPurchase]) = MONTH([Date])&#13;&#10;    THEN [CustomerKey]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='06. Returning Customers YTD' datatype='integer' name='[Calculation_1751055891909840897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF YEAR([Date]) = YEAR([Calculation_1423981968018972672]) AND&#13;&#10;    MONTH([Date]) &lt;= MONTH(TODAY()) AND&#13;&#10;    [Date] &lt;= [Calculation_1423981968018972672]&#13;&#10;THEN&#13;&#10;&#13;&#10;        IF [FirstPurchase] &lt; MAKEDATE(YEAR([Calculation_1423981968018972672]), 1, 1)&#13;&#10;        THEN [CustomerKey]&#13;&#10;        END&#13;&#10;&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='06. % New' datatype='real' default-format='p0.0%' name='[Calculation_1751055891918893063]' role='measure' type='quantitative'>
