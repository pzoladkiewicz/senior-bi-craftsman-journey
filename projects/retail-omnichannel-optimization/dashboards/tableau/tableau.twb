      <column caption='04. KPI YoY Customers YTD' datatype='real' default-format='p0.0%' name='[Calculation_1646347199986167824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({COUNTD([01. 2011 YTD Sales - FIXED (copy)_1646347199984623630])} - {COUNTD([04. 2011 YTD Customers - FIXED (copy)_1646347199984889871])})&#13;&#10;/&#13;&#10;{COUNTD([01. 2011 YTD Sales - FIXED (copy)_1646347199984623630])}' />
