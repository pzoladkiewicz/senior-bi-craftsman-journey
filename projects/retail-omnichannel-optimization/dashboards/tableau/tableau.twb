    <worksheet name='33. KPI Quality Index'>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_transactions_classified' name='federated.043zsgd03ajrzj1edwg1s0ln338l' />
          </datasources>
          <datasource-dependencies datasource='federated.043zsgd03ajrzj1edwg1s0ln338l'>
            <column caption='30. CY YTD T|F' datatype='boolean' name='[30. T|F 2011SameMD (copy)_1058345977861468193]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([InvoiceDate]) = YEAR(TODAY())&#13;&#10;AND &#13;&#10;DATE([InvoiceDate]) &lt;= TODAY()' />
            </column>
            <column caption='33.1 Operations Quality Index' datatype='real' default-format='p0.0%' name='[Calculation_1570348958054420482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    COUNT(IF [TransactionCategory] = &quot;ValidSales&quot;&#13;&#10;    THEN [Invoice]&#13;&#10;    END)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    COUNT(IF [TransactionCategory] = &quot;ValidSales&quot;&#13;&#10;    THEN [Invoice]&#13;&#10;    END)&#13;&#10;+&#13;&#10;    COUNT(IF [TransactionCategory] IN &#13;&#10;    (&#13;&#10;                &quot;DataError&quot;,&#13;&#10;                &quot;ManualAdjustment&quot;,&#13;&#10;                &quot;Unclassified&quot;&#13;&#10;    )&#13;&#10;    THEN [Invoice]&#13;&#10;    END)&#13;&#10;)' />
            </column>
            <column caption='33.2 Quality Cost Impact' datatype='real' default-format='c&quot;£&quot;#,##0,.0K;-&quot;£&quot;#,##0,.0K' name='[Calculation_1570348958056284163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(SUM(&#13;&#10;IF [TransactionCategory] IN&#13;&#10;(&#13;&#10;            &quot;ManualAdjustment&quot;,&#13;&#10;            &quot;Unclassified&quot;&#13;&#10;)&#13;&#10;THEN [TotalValue]&#13;&#10;END&#13;&#10;))' />
            </column>
            <column datatype='datetime' name='[InvoiceDate]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Invoice]' role='dimension' type='nominal' />
            <column caption='c_TotalValue' datatype='real' name='[TotalValue]' role='measure' type='quantitative' />
            <column datatype='string' name='[TransactionCategory]' role='dimension' type='nominal' />
            <column-instance column='[30. T|F 2011SameMD (copy)_1058345977861468193]' derivation='None' name='[none:30. T|F 2011SameMD (copy)_1058345977861468193:nk]' pivot='key' type='nominal' />
