          </datasources>
          <datasource-dependencies datasource='federated.14868jm04ibtmb11ma5k81urcdxs'>
            <column caption='-([fact_sales+].[11.6 Revenue Growth Analysis])' datatype='real' name='[Calculation_1651976700634423299]' role='measure' type='quantitative' user:unnamed='Revenue Growth Analysis (2)'>
              <calculation class='tableau' formula='-([federated.1vbucgb1f0or7y11v3r3q02xzapd].[Calculation_1601029729807593503])' />
            </column>
            <column datatype='integer' name='[ComponentID]' role='dimension' type='ordinal' />
            <column datatype='string' name='[ComponentName]' role='dimension' type='nominal' />
            <column datatype='integer' name='[ComponentOrder]' role='measure' type='quantitative' />
            <column-instance column='[ComponentName]' derivation='None' name='[none:ComponentName:nk]' pivot='key' type='nominal' />
            <column-instance column='[ComponentOrder]' derivation='Sum' name='[sum:ComponentOrder:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1651976700634423299]' derivation='User' name='[usr:Calculation_1651976700634423299:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vbucgb1f0or7y11v3r3q02xzapd'>
            <column caption='02. 2010 YTD AVG Price' datatype='real' name='[01. 2011 YTD AVG Price (copy)_1601029729699966993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([01. 2011 YTD Sales (copy)_1646347199961169925]) / SUM([02. 2010 YTD Sales (copy)_1601029729692545039])' />
            </column>
            <column caption='01. 2011 YTD Quantity' datatype='integer' name='[01. 2011 YTD Sales (copy)_1601029729692434446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [_Anchor 2011SameMD (copy)_1646347199960289281] and YEAR([Date]) = 2011&#13;&#10;            then [Quantity]&#13;&#10;            END' />
            </column>
            <column caption='01. 2011 YTD AVG Price' datatype='real' name='[01. 2011 YTD Sales (copy)_1601029729699614736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1646347199960813572]) / SUM([01. 2011 YTD Sales (copy)_1601029729692434446])' />
            </column>
            <column caption='02. 2010 YTD Sales' datatype='real' name='[01. 2011 YTD Sales (copy)_1646347199961169925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [_2011SameMD (copy)_1646347199960379394] and YEAR([Date]) = 2010&#13;&#10;then [TotalValue]&#13;&#10;END' />
            </column>
            <column caption='02. 2010 YTD Quantity' datatype='integer' name='[02. 2010 YTD Sales (copy)_1601029729692545039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [_2011SameMD (copy)_1646347199960379394] and YEAR([Date]) = 2010&#13;&#10;then [Quantity]&#13;&#10;END' />
            </column>
            <column caption='11.6 Gantt CF' datatype='string' name='[11.6 Categories (copy)_1601029729809825828]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE ATTR([federated.14868jm04ibtmb11ma5k81urcdxs].[ComponentID])&#13;&#10;WHEN 2 THEN IF SUM([Calculation_1601029729731395602]) &gt;= 0 THEN &quot;+&quot; ELSE &quot;-&quot; end&#13;&#10;WHEN 3 THEN IF SUM([Calculation_1601029729731833875]) &gt;= 0 THEN &quot;+&quot; ELSE &quot;-&quot; end&#13;&#10;WHEN 4 THEN if SUM([Calculation_1601029729732395028]) &gt;= 0 THEN &quot;+&quot; ELSE &quot;-&quot; end&#13;&#10;END' />
            </column>
            <column caption='11.7 Labels' datatype='real' default-format='c&quot;£&quot;#,##0,K;-&quot;£&quot;#,##0,K' name='[11.6 Categories (copy)_1601029729812652069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case ATTR([federated.14868jm04ibtmb11ma5k81urcdxs].[ComponentID])&#13;&#10;WHEN 1 THEN SUM([Calculation_1601029729690677259])&#13;&#10;WHEN 2 THEN SUM([Calculation_1601029729731395602])&#13;&#10;WHEN 3 THEN SUM([Calculation_1601029729731833875])&#13;&#10;WHEN 4 THEN SUM([Calculation_1601029729732395028])&#13;&#10;WHEN 5 THEN SUM([Calculation_1601029729733251093])&#13;&#10;END' />
            </column>
            <column caption='11.1 Base 2010' datatype='real' name='[Calculation_1601029729690677259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{SUM([01. 2011 YTD Sales (copy)_1646347199961169925])}' />
            </column>
            <column caption='11.2 Volume Effect' datatype='real' name='[Calculation_1601029729731395602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//    (Qty2011 - Qty2010) * AvgPrice2010&#13;&#10;({SUM([01. 2011 YTD Sales (copy)_1601029729692434446])}  - {SUM([02. 2010 YTD Sales (copy)_1601029729692545039])})&#13;&#10;*&#13;&#10;{[01. 2011 YTD AVG Price (copy)_1601029729699966993]}' />
            </column>
            <column caption='11.3 Price Effect' datatype='real' name='[Calculation_1601029729731833875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//   Qty2011 * (AvgPrice2011 - AvgPrice2010)&#13;&#10;({[01. 2011 YTD Sales (copy)_1601029729699614736]} - {[01. 2011 YTD AVG Price (copy)_1601029729699966993]})&#13;&#10;*&#13;&#10;{SUM([01. 2011 YTD Sales (copy)_1601029729692434446])}' />
            </column>
            <column caption='11.4 Mix Effect' datatype='real' name='[Calculation_1601029729732395028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Mix Effect = &#13;&#10;//VAR TotalCalculated = [2010 Base Revenue] + [Volume Effect] + [Price Effect]&#13;&#10;//VAR ActualTotal = [2011 Total Revenue]&#13;&#10;//RETURN&#13;&#10;//    ActualTotal - TotalCalculated&#13;&#10;&#13;&#10;{SUM([Calculation_1646347199960813572])} - (&#13;&#10;{SUM([01. 2011 YTD Sales (copy)_1646347199961169925])} + {SUM([Calculation_1601029729731395602])} + {SUM([Calculation_1601029729731833875])}&#13;&#10;)' />
            </column>
            <column caption='11.5 Total 2011' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[Calculation_1601029729733251093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{SUM([Calculation_1646347199960813572])}' />
            </column>
            <column caption='11.6 Revenue Growth Analysis' datatype='real' default-format='c&quot;£&quot;#,##0,K;-&quot;£&quot;#,##0,K' name='[Calculation_1601029729807593503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case ATTR([federated.14868jm04ibtmb11ma5k81urcdxs].[ComponentID])&#13;&#10;when 1 then SUM([Calculation_1601029729690677259])&#13;&#10;when 2 then SUM([Calculation_1601029729731395602])&#13;&#10;when 3 THEN SUM([Calculation_1601029729731833875])&#13;&#10;when 4 then SUM([Calculation_1601029729732395028])&#13;&#10;WHEN 5 THEN -SUM([Calculation_1601029729733251093])&#13;&#10;END' />
            </column>
            <column caption='01. 2011 YTD Sales' datatype='real' name='[Calculation_1646347199960813572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [_Anchor 2011SameMD (copy)_1646347199960289281] and YEAR([Date]) = 2011&#13;&#10;THEN [TotalValue]&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column datatype='real' default-format='n#,##0,K;-#,##0,K' name='[TotalValue]' role='measure' type='quantitative' />
            <column caption='_2010SameMD' datatype='boolean' name='[_2011SameMD (copy)_1646347199960379394]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Date] &lt;= MAKEDATE(2010, MONTH(TODAY()), DAY(TODAY()))' />
