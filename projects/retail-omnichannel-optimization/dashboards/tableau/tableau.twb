              <calculation class='tableau' formula='IF [TransactionCategory] IN&#13;&#10;    (&#13;&#10;           &quot;ValidSales&quot;,&#13;&#10;            &quot;Postage&quot;,&#13;&#10;            &quot;DCGSProducts&quot;,&#13;&#10;            &quot;TransportCost&quot;&#13;&#10;)&#13;&#10;    AND YEAR([InvoiceDate]) = 2011&#13;&#10;    AND [Calculation_199002871378493442]&#13;&#10;THEN [TotalValue]&#13;&#10;END' />
