      <column caption='_Anchor 2011SameMD' datatype='date' name='[Calculation_1423981968018972672]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE(2011, MONTH(TODAY()), DAY(TODAY()))' />
      </column>
      <column caption='01. 2011 YTD Sales - Cont.' datatype='real' name='[Calculation_1646347199960813572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [_Anchor 2011SameMD (copy)_1646347199960289281] and YEAR([Date]) = 2011&#13;&#10;            then [TotalValue]&#13;&#10;            END' />
