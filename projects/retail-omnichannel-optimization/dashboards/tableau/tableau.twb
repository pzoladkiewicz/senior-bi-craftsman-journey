            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1vbucgb1f0or7y11v3r3q02xzapd].[pcto:usr:Calculation_1646347200206495787:qk:4]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1vbucgb1f0or7y11v3r3q02xzapd].[pcto:usr:Calculation_1751055891909840897:qk:4]&quot;' />
