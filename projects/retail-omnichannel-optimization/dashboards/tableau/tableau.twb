      <column caption='09. Intl Growth Rate' datatype='real' default-format='p0.0%' name='[Calculation_1601029729463115782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [IsUK (dim_geography.csv)] = 0&#13;&#10;    THEN&#13;&#10;    [Calculation_1646347199960813572]&#13;&#10;    //[02. 2010 YTD Sales - Cont.]&#13;&#10;    END&#13;&#10;)&#13;&#10;    /&#13;&#10;SUM(&#13;&#10;    IF [IsUK (dim_geography.csv)] = 0&#13;&#10;    THEN&#13;&#10;    //[01. 2011 YTD Sales - Cont.]&#13;&#10;    [01. 2011 YTD Sales (copy)_1646347199961169925]&#13;&#10;    END&#13;&#10;) -1' />
      </column>
      <column caption='09. UK Growth Rate' datatype='real' default-format='p0.0%' name='[Calculation_1601029729466748935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF [IsUK (dim_geography.csv)] = 1&#13;&#10;    THEN&#13;&#10;    [Calculation_1646347199960813572]&#13;&#10;    END&#13;&#10;)&#13;&#10;    -&#13;&#10;SUM(&#13;&#10;    IF [IsUK (dim_geography.csv)] = 1&#13;&#10;    THEN&#13;&#10;    [01. 2011 YTD Sales (copy)_1646347199961169925]&#13;&#10;    END&#13;&#10;) &#13;&#10;) /&#13;&#10;SUM(&#13;&#10;    IF [IsUK (dim_geography.csv)] = 1&#13;&#10;    THEN&#13;&#10;    [01. 2011 YTD Sales (copy)_1646347199961169925]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='10. Channel Score' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1601029729661317129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Channel Score (2011) = &#13;&#10;//VAR UKShare = [UK Sales Share % (2011)]&#13;&#10;//VAR IntlShare = 1 - UKShare&#13;&#10;//VAR GuestShare = [Guest Transactions % (2011)]&#13;&#10;//VAR RegisteredShare = 1 - GuestShare&#13;&#10;//RETURN&#13;&#10;//    (UKShare * 0.4) + (IntlShare * 0.3) + (RegisteredShare * 0.3)&#13;&#10;&#13;&#10;(SUM([Calculation_1601029729426075648]) * 0.4) + ([Calculation_1601029729427025921] * 0.3) + ([Calculation_1601029729462673413] * 0.3)' />
      </column>
      <column caption='11.1 Base 2010' datatype='real' name='[Calculation_1601029729690677259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{SUM([01. 2011 YTD Sales (copy)_1646347199961169925])}' />
      </column>
      <column caption='11.2 Volume Effect' datatype='real' name='[Calculation_1601029729731395602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//    (Qty2011 - Qty2010) * AvgPrice2010&#13;&#10;({SUM([01. 2011 YTD Sales (copy)_1601029729692434446])}  - {SUM([02. 2010 YTD Sales (copy)_1601029729692545039])})&#13;&#10;*&#13;&#10;{[01. 2011 YTD AVG Price (copy)_1601029729699966993]}' />
      </column>
      <column caption='11.3 Price Effect' datatype='real' name='[Calculation_1601029729731833875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//   Qty2011 * (AvgPrice2011 - AvgPrice2010)&#13;&#10;({[01. 2011 YTD Sales (copy)_1601029729699614736]} - {[01. 2011 YTD AVG Price (copy)_1601029729699966993]})&#13;&#10;*&#13;&#10;{SUM([01. 2011 YTD Sales (copy)_1601029729692434446])}' />
      </column>
      <column caption='11.4 Mix Effect' datatype='real' name='[Calculation_1601029729732395028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Mix Effect = &#13;&#10;//VAR TotalCalculated = [2010 Base Revenue] + [Volume Effect] + [Price Effect]&#13;&#10;//VAR ActualTotal = [2011 Total Revenue]&#13;&#10;//RETURN&#13;&#10;//    ActualTotal - TotalCalculated&#13;&#10;&#13;&#10;{SUM([Calculation_1646347199960813572])} - (&#13;&#10;{SUM([01. 2011 YTD Sales (copy)_1646347199961169925])} + {SUM([Calculation_1601029729731395602])} + {SUM([Calculation_1601029729731833875])}&#13;&#10;)' />
      </column>
      <column caption='11.5 Total 2011' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[Calculation_1601029729733251093]' role='measure' type='quantitative'>
