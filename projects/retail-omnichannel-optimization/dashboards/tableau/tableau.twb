      <column caption='09. UK Growth Rate' datatype='real' default-format='p0.0%' name='[Calculation_1601029729466748935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF [IsUK (dim_geography.csv)] = 1&#13;&#10;    THEN&#13;&#10;    [Calculation_1646347199960813572]&#13;&#10;    END&#13;&#10;)&#13;&#10;    -&#13;&#10;SUM(&#13;&#10;    IF [IsUK (dim_geography.csv)] = 1&#13;&#10;    THEN&#13;&#10;    [01. 2011 YTD Sales (copy)_1646347199961169925]&#13;&#10;    END&#13;&#10;) &#13;&#10;) /&#13;&#10;SUM(&#13;&#10;    IF [IsUK (dim_geography.csv)] = 1&#13;&#10;    THEN&#13;&#10;    [01. 2011 YTD Sales (copy)_1646347199961169925]&#13;&#10;    END&#13;&#10;)' />
