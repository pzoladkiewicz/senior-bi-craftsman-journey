      <column caption='00. CY YTD T|F' datatype='boolean' name='[Calculation_1058345976992018432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([Date]) = YEAR(TODAY())&#13;&#10;AND &#13;&#10;[Date] &lt;= TODAY()' />
      </column>
      <column caption='21.1 UK Sales' datatype='real' default-format='p0%' name='[Calculation_1601029729426075648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [IsUK (dim_geography.csv)] = 1&#13;&#10;THEN [TotalValue]&#13;&#10;END)&#13;&#10;//IIF([IsUK (dim_geography.csv)] = 1,  [01. Sales CY YTD], 0)&#13;&#10; / &#13;&#10; ([Calculation_1646347199960813572])' />
      </column>
      <column caption='21.2 Intl Sales' datatype='real' default-format='p0%' name='[Calculation_1601029729427025921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_1601029729426075648]' />
      </column>
      <column caption='22.1 Guest Transactions' datatype='real' default-format='p0%' name='[Calculation_1601029729428357124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [CustomerType] = &quot;Guest&quot;&#13;&#10;    THEN [InvoiceNumber]&#13;&#10;    END&#13;&#10;)&#13;&#10;/ &#13;&#10;COUNT([InvoiceNumber])' />
      </column>
      <column caption='22.2 Registered Transactions' datatype='real' default-format='p0%' name='[Calculation_1601029729462673413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_1601029729428357124]' />
      </column>
      <column caption='24.1. Intl Growth Rate' datatype='real' default-format='p0.0%' name='[Calculation_1601029729463115782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    IF [IsUK (dim_geography.csv)] = 0&#13;&#10;    THEN&#13;&#10;    {[Calculation_1646347199960813572]}&#13;&#10;    END&#13;&#10;)&#13;&#10;    /&#13;&#10;(&#13;&#10;    IF [IsUK (dim_geography.csv)] = 0&#13;&#10;    THEN&#13;&#10;    {[01. Sales CY YTD (copy)_1058345976995577860]}&#13;&#10;    END&#13;&#10;) -1' />
      </column>
      <column caption='23. Channel Score' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1601029729661317129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Channel Score (2011) = &#13;&#10;//VAR UKShare = [UK Sales Share % (2011)]&#13;&#10;//VAR IntlShare = 1 - UKShare&#13;&#10;//VAR GuestShare = [Guest Transactions % (2011)]&#13;&#10;//VAR RegisteredShare = 1 - GuestShare&#13;&#10;//RETURN&#13;&#10;//    (UKShare * 0.4) + (IntlShare * 0.3) + (RegisteredShare * 0.3)&#13;&#10;&#13;&#10;([Calculation_1601029729426075648] * 0.4) + ([Calculation_1601029729427025921] * 0.3) + ([Calculation_1601029729462673413] * 0.3)' />
      </column>
      <column caption='25.1 Base PY YTD' datatype='real' name='[Calculation_1601029729690677259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[01. Sales CY YTD (copy)_1058345976995577860]' />
      </column>
      <column caption='25.2 Volume Effect' datatype='real' name='[Calculation_1601029729731395602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//    (Qty2011 - Qty2010) * AvgPrice2010&#13;&#10;([00. # Orders CY YTD (copy)_1058345977842724884]  - [00. Quantity CY YTD (copy)_1058345977842872341])&#13;&#10;*&#13;&#10;[00. AVG Price CY YTD (copy)_1058345977843322903]' />
      </column>
      <column caption='25.3 Price Effect' datatype='real' name='[Calculation_1601029729731833875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//   Qty2011 * (AvgPrice2011 - AvgPrice2010)&#13;&#10;([00. Quantity CY YTD (copy)_1058345977843163158] - [00. AVG Price CY YTD (copy)_1058345977843322903])&#13;&#10;*&#13;&#10;[00. # Orders CY YTD (copy)_1058345977842724884]' />
      </column>
      <column caption='25.4 Mix Effect' datatype='real' name='[Calculation_1601029729732395028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Mix Effect = &#13;&#10;//VAR TotalCalculated = [2010 Base Revenue] + [Volume Effect] + [Price Effect]&#13;&#10;//VAR ActualTotal = [2011 Total Revenue]&#13;&#10;//RETURN&#13;&#10;//    ActualTotal - TotalCalculated&#13;&#10;&#13;&#10;[Calculation_1646347199960813572] - &#13;&#10;(&#13;&#10;[Calculation_1601029729690677259] + [Calculation_1601029729731395602] + [Calculation_1601029729731833875]&#13;&#10;)' />
      </column>
      <column caption='25.5 Total 2011' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[Calculation_1601029729733251093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1646347199960813572]' />
      </column>
      <column caption='25.6 Revenue Growth Analysis' datatype='real' default-format='c&quot;£&quot;#,##0,K;-&quot;£&quot;#,##0,K' name='[Calculation_1601029729807593503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case ATTR([federated.14868jm04ibtmb11ma5k81urcdxs].[ComponentID])&#13;&#10;when 1 then [Calculation_1601029729690677259]&#13;&#10;when 2 then [Calculation_1601029729731395602]&#13;&#10;when 3 THEN [Calculation_1601029729731833875]&#13;&#10;when 4 then [Calculation_1601029729732395028]&#13;&#10;WHEN 5 THEN -[Calculation_1601029729733251093]&#13;&#10;END' />
      </column>
      <column caption='01. Sales CY YTD' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[Calculation_1646347199960813572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([Calculation_1058345976992018432]) * [TotalValue])' />
      </column>
      <column caption='03. Sales YoY %' datatype='real' default-format='p0.0%' name='[Calculation_1646347199966896136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1646347199960813572] - [01. Sales CY YTD (copy)_1058345976995577860]) &#13;&#10;/ [01. Sales CY YTD (copy)_1058345976995577860]' />
      </column>
      <column caption='03.2 Sales YoY% CF (+)' datatype='real' default-format='*▲0.0%;▼0.0%;0.0%' name='[Calculation_1646347199968522250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1646347199966896136] &gt;= 0 then [Calculation_1646347199966896136] end' />
      </column>
      <column caption='04.3 Customers YoY %' datatype='real' default-format='p0.0%' name='[Calculation_1646347199986167824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([01. Sales CY YTD (copy)_1058345977045078021] - [04. # Customers CY YTD (copy)_1058345977045495814])&#13;&#10;/&#13;&#10;[04. # Customers CY YTD (copy)_1058345977045495814]' />
      </column>
      <column caption='06.1 New Customers YTD' datatype='integer' name='[Calculation_1646347200206495787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF YEAR([Date]) = YEAR(TODAY()) AND [Date] &lt;= TODAY()&#13;&#10;    THEN&#13;&#10;       &#13;&#10;            If YEAR([FirstPurchase]) = YEAR(TODAY())&#13;&#10;                AND MONTH([FirstPurchase]) = MONTH([Date])&#13;&#10;            THEN [CustomerKey]&#13;&#10;            END&#13;&#10;        &#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='06.2 Returning Customers YTD' datatype='integer' name='[Calculation_1751055891909840897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF YEAR([Date]) = YEAR(TODAY()) AND [Date] &lt;= TODAY()&#13;&#10;THEN&#13;&#10;&#13;&#10;        IF (YEAR([FirstPurchase]) &lt; YEAR(TODAY())&#13;&#10;            OR  (YEAR([FirstPurchase]) = YEAR(TODAY()) AND  MONTH([FirstPurchase]) &lt; MONTH([Date])))&#13;&#10;            AND (YEAR([Date]) = YEAR([FirstPurchase]) OR [Date] &gt;= [FirstPurchase])&#13;&#10;        THEN [CustomerKey]&#13;&#10;        END&#13;&#10;&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='06. % New' datatype='real' default-format='p0.0%' name='[Calculation_1751055891918893063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1646347200206495787] / &#13;&#10;([Calculation_1646347200206495787] + [Calculation_1751055891909840897])' />
      </column>
      <column caption='12. Country Group' datatype='string' name='[Calculation_1751337367584542720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Country Group&#13;&#10;CASE [Country (dim_geography.csv)]&#13;&#10;    WHEN &quot;Netherlands&quot; THEN &quot;Netherlands&quot;&#13;&#10;    WHEN &quot;Ireland&quot; THEN &quot;Ireland&quot;&#13;&#10;    WHEN &quot;Germany&quot; THEN &quot;Germany&quot;&#13;&#10;    WHEN &quot;France&quot; THEN &quot;France&quot; &#13;&#10;    WHEN &quot;Australia&quot; THEN &quot;Australia&quot;&#13;&#10;    ELSE &quot;Others&quot;&#13;&#10;END' />
      </column>
