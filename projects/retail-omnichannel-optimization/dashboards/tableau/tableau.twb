    <worksheet name='Strategic Product Positioning [Volume vs Revenue Analysis]'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Regular' fontsize='9'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_transactions_classified' name='federated.043zsgd03ajrzj1edwg1s0ln338l' />
          </datasources>
          <datasource-dependencies datasource='federated.043zsgd03ajrzj1edwg1s0ln338l'>
            <column caption='35.1 Product Transaction Volume' datatype='integer' name='[Calculation_1570348958287900681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [TransactionCategory] = &quot;ValidSales&quot;&#13;&#10;    THEN [StockCode]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='36.1 Product AOV' datatype='real' default-format='C2057%' name='[Calculation_1570348958288384010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_199002871379718149])&#13;&#10;/&#13;&#10;[Calculation_1570348958287900681]' />
            </column>
            <column caption='35.2 Volume vs Revenue Tier Colors' datatype='string' name='[Calculation_1570348958305333259]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_199002871379718149]) &gt;= 20000  AND [Calculation_1570348958287900681] &gt;= 600 THEN &quot;stars&quot;&#13;&#10;ELSEIF SUM([Calculation_199002871379718149]) &gt;= 20000  AND [Calculation_1570348958287900681] &lt; 600 THEN &quot;premium&quot;&#13;&#10;ELSEIF  SUM([Calculation_199002871379718149]) &lt; 20000  AND [Calculation_1570348958287900681] &gt;= 600 THEN &quot;volume&quot;    &#13;&#10;ELSEIF SUM([Calculation_199002871379718149]) &lt; 20000  AND [Calculation_1570348958287900681] &lt; 600 THEN &quot;evaluate&quot;&#13;&#10;END' />
            </column>
            <column caption='30. T|F 2011SameMD' datatype='boolean' name='[Calculation_199002871378493442]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATE([InvoiceDate]) &lt;= MAKEDATE(2011, MONTH(TODAY()), DAY(TODAY()))' />
            </column>
            <column caption='31. Net Revenue per Product YTD (_2011)' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[Calculation_199002871379718149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [TransactionCategory] = &quot;ValidSales&quot;&#13;&#10;    AND YEAR([InvoiceDate]) = 2011&#13;&#10;    AND [Calculation_199002871378493442]&#13;&#10;THEN [TotalValue]&#13;&#10;END' />
            </column>
            <column datatype='datetime' name='[InvoiceDate]' role='dimension' type='ordinal' />
            <column caption='c_StockCode' datatype='string' name='[StockCode]' role='dimension' type='nominal' />
            <column caption='c_TotalValue' datatype='real' name='[TotalValue]' role='measure' type='quantitative' />
            <column datatype='string' name='[TransactionCategory]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_199002871378493442]' derivation='None' name='[none:Calculation_199002871378493442:nk]' pivot='key' type='nominal' />
