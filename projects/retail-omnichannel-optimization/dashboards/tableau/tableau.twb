            <column caption='-([fact_sales+].[25.6 Revenue Growth Analysis])' datatype='real' name='[Calculation_1651976700634423299]' role='measure' type='quantitative' user:unnamed='Revenue Growth Analysis (2)'>
              <calculation class='tableau' formula='-([federated.1vbucgb1f0or7y11v3r3q02xzapd].[Calculation_1601029729807593503])' />
            </column>
            <column datatype='integer' name='[ComponentID]' role='dimension' type='ordinal' />
            <column datatype='string' name='[ComponentName]' role='dimension' type='nominal' />
            <column datatype='integer' name='[ComponentOrder]' role='measure' type='quantitative' />
            <column-instance column='[ComponentName]' derivation='None' name='[none:ComponentName:nk]' pivot='key' type='nominal' />
            <column-instance column='[ComponentOrder]' derivation='Sum' name='[sum:ComponentOrder:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1651976700634423299]' derivation='User' name='[usr:Calculation_1651976700634423299:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vbucgb1f0or7y11v3r3q02xzapd'>
            <column caption='00. Quantity CY YTD' datatype='integer' name='[00. # Orders CY YTD (copy)_1058345977842724884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_1058345976992018432]&#13;&#10;    THEN [Quantity]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='00. AVG Price PY YTD' datatype='real' default-format='N' name='[00. AVG Price CY YTD (copy)_1058345977843322903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[01. Sales CY YTD (copy)_1058345976995577860] /[00. Quantity CY YTD (copy)_1058345977842872341]' />
            </column>
            <column caption='00. PY YTD T|F' datatype='boolean' name='[00. CY YTD (copy)_1058345976993832961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([Date]) = YEAR(TODAY()) -1&#13;&#10;AND &#13;&#10;[Date] &lt;=  DATEADD(&apos;month&apos;, -12, TODAY())' />
            </column>
            <column caption='00. Quantity PY YTD' datatype='integer' name='[00. Quantity CY YTD (copy)_1058345977842872341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [00. CY YTD (copy)_1058345976993832961]&#13;&#10;    THEN [Quantity]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='00. AVG Price CY YTD' datatype='real' default-format='N' name='[00. Quantity CY YTD (copy)_1058345977843163158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1646347199960813572] / [00. # Orders CY YTD (copy)_1058345977842724884]' />
            </column>
            <column caption='02. Sales PY YTD' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[01. Sales CY YTD (copy)_1058345976995577860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(INT([00. CY YTD (copy)_1058345976993832961]) * [TotalValue])' />
            </column>
            <column caption='25.6 Gantt CF' datatype='string' name='[11.6 Categories (copy)_1601029729809825828]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE ATTR([federated.14868jm04ibtmb11ma5k81urcdxs].[ComponentID])&#13;&#10;WHEN 2 THEN IF [Calculation_1601029729731395602] &gt;= 0 THEN &quot;+&quot; ELSE &quot;-&quot; end&#13;&#10;WHEN 3 THEN IF [Calculation_1601029729731833875] &gt;= 0 THEN &quot;+&quot; ELSE &quot;-&quot; end&#13;&#10;WHEN 4 THEN if [Calculation_1601029729732395028] &gt;= 0 THEN &quot;+&quot; ELSE &quot;-&quot; end&#13;&#10;END' />
            </column>
            <column caption='25.7 Labels' datatype='real' default-format='c&quot;£&quot;#,##0,K;-&quot;£&quot;#,##0,K' name='[11.6 Categories (copy)_1601029729812652069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case ATTR([federated.14868jm04ibtmb11ma5k81urcdxs].[ComponentID])&#13;&#10;WHEN 1 THEN [Calculation_1601029729690677259]&#13;&#10;WHEN 2 THEN [Calculation_1601029729731395602]&#13;&#10;WHEN 3 THEN [Calculation_1601029729731833875]&#13;&#10;WHEN 4 THEN [Calculation_1601029729732395028]&#13;&#10;WHEN 5 THEN [Calculation_1601029729733251093]&#13;&#10;END' />
            </column>
            <column caption='00. CY YTD T|F' datatype='boolean' name='[Calculation_1058345976992018432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([Date]) = YEAR(TODAY())&#13;&#10;AND &#13;&#10;[Date] &lt;= TODAY()' />
            </column>
            <column caption='25.1 Base PY YTD' datatype='real' name='[Calculation_1601029729690677259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[01. Sales CY YTD (copy)_1058345976995577860]' />
            </column>
            <column caption='25.2 Volume Effect' datatype='real' name='[Calculation_1601029729731395602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//    (Qty2011 - Qty2010) * AvgPrice2010&#13;&#10;([00. # Orders CY YTD (copy)_1058345977842724884]  - [00. Quantity CY YTD (copy)_1058345977842872341])&#13;&#10;*&#13;&#10;[00. AVG Price CY YTD (copy)_1058345977843322903]' />
            </column>
            <column caption='25.3 Price Effect' datatype='real' name='[Calculation_1601029729731833875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//   Qty2011 * (AvgPrice2011 - AvgPrice2010)&#13;&#10;([00. Quantity CY YTD (copy)_1058345977843163158] - [00. AVG Price CY YTD (copy)_1058345977843322903])&#13;&#10;*&#13;&#10;[00. # Orders CY YTD (copy)_1058345977842724884]' />
            </column>
            <column caption='25.4 Mix Effect' datatype='real' name='[Calculation_1601029729732395028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Mix Effect = &#13;&#10;//VAR TotalCalculated = [2010 Base Revenue] + [Volume Effect] + [Price Effect]&#13;&#10;//VAR ActualTotal = [2011 Total Revenue]&#13;&#10;//RETURN&#13;&#10;//    ActualTotal - TotalCalculated&#13;&#10;&#13;&#10;[Calculation_1646347199960813572] - &#13;&#10;(&#13;&#10;[Calculation_1601029729690677259] + [Calculation_1601029729731395602] + [Calculation_1601029729731833875]&#13;&#10;)' />
            </column>
            <column caption='25.5 Total 2011' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[Calculation_1601029729733251093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1646347199960813572]' />
            </column>
            <column caption='25.6 Revenue Growth Analysis' datatype='real' default-format='c&quot;£&quot;#,##0,K;-&quot;£&quot;#,##0,K' name='[Calculation_1601029729807593503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case ATTR([federated.14868jm04ibtmb11ma5k81urcdxs].[ComponentID])&#13;&#10;when 1 then [Calculation_1601029729690677259]&#13;&#10;when 2 then [Calculation_1601029729731395602]&#13;&#10;when 3 THEN [Calculation_1601029729731833875]&#13;&#10;when 4 then [Calculation_1601029729732395028]&#13;&#10;WHEN 5 THEN -[Calculation_1601029729733251093]&#13;&#10;END' />
            </column>
            <column caption='01. Sales CY YTD' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[Calculation_1646347199960813572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(INT([Calculation_1058345976992018432]) * [TotalValue])' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column datatype='real' default-format='n#,##0,K;-#,##0,K' name='[TotalValue]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1601029729807593503]' derivation='User' name='[cum:usr:Calculation_1601029729807593503:qk]' pivot='key' type='quantitative'>
