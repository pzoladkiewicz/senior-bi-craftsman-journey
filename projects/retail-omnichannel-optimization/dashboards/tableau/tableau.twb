      <aliases enabled='yes' />
      <column caption='31. Business Gross Revenue YTD (_2011)' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[31. Net Revenue per Product YTD (_2011) (copy)_199002871380549639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [TransactionCategory] IN&#13;&#10;    (&#13;&#10;           &quot;ValidSales&quot;,&#13;&#10;            &quot;Postage&quot;,&#13;&#10;            &quot;DCGSProducts&quot;,&#13;&#10;            &quot;TransportCost&quot;&#13;&#10;)&#13;&#10;    AND YEAR([InvoiceDate]) = 2011&#13;&#10;    AND [Calculation_199002871378493442]&#13;&#10;THEN [TotalValue]&#13;&#10;END' />
      </column>
      <column caption='34. Efficiency Gap (-)' datatype='real' default-format='*▲0.0%;▼0.0%;0.0%' name='[34. Efficiency Gap (+) (copy)_1570348958062792712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Calculation_1570348958061527046] - .95) &lt; 0&#13;&#10;THEN ([Calculation_1570348958061527046] - .95)&#13;&#10;END' />
      </column>
      <column caption='32. Returns' datatype='real' default-format='c&quot;£&quot;#,##0,.0K;-&quot;£&quot;#,##0,.0K' name='[Calculation_1570348957927321600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [TransactionCategory] = &quot;Returns&quot;&#13;&#10;    AND YEAR([InvoiceDate]) = 2011&#13;&#10;    AND [Calculation_199002871378493442]&#13;&#10;THEN [TotalValue]&#13;&#10;END' />
      </column>
      <column caption='32. Return Rate' datatype='real' default-format='p0.0%' name='[Calculation_1570348957927583745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1570348957927321600]) / ZN(SUM([Calculation_199002871379718149]))' />
      </column>
      <column caption='33. Operations Quality Index' datatype='real' default-format='p0.0%' name='[Calculation_1570348958054420482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    COUNT(IF [TransactionCategory] = &quot;ValidSales&quot;&#13;&#10;    THEN [Invoice]&#13;&#10;    END)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;    COUNT(IF [TransactionCategory] = &quot;ValidSales&quot;&#13;&#10;    THEN [Invoice]&#13;&#10;    END)&#13;&#10;+&#13;&#10;    COUNT(IF [TransactionCategory] IN &#13;&#10;    (&#13;&#10;                &quot;DataError&quot;,&#13;&#10;                &quot;ManualAdjustment&quot;,&#13;&#10;                &quot;Unclassified&quot;&#13;&#10;    )&#13;&#10;    THEN [Invoice]&#13;&#10;    END)&#13;&#10;)' />
      </column>
      <column caption='33. Quality Cost Impact' datatype='real' default-format='c&quot;£&quot;#,##0,.0K;-&quot;£&quot;#,##0,.0K' name='[Calculation_1570348958056284163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(SUM(&#13;&#10;IF [TransactionCategory] IN&#13;&#10;(&#13;&#10;            &quot;ManualAdjustment&quot;,&#13;&#10;            &quot;Unclassified&quot;&#13;&#10;)&#13;&#10;THEN [TotalValue]&#13;&#10;END&#13;&#10;))' />
      </column>
      <column caption='34. Business Gross Revenue' datatype='real' name='[Calculation_1570348958061088773]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [TransactionCategory] IN (&#13;&#10;            &quot;ValidSales&quot;,&#13;&#10;            &quot;Postage&quot;,&#13;&#10;            &quot;DCGSProducts&quot;,&#13;&#10;            &quot;TransportCost&quot;&#13;&#10;)&#13;&#10;THEN [TotalValue]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='34. Business Efficiency' datatype='real' default-format='p0.0%' name='[Calculation_1570348958061527046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_199002871379718149])&#13;&#10;/&#13;&#10;[Calculation_1570348958061088773]' />
      </column>
      <column caption='34. Efficiency Gap (+)' datatype='real' default-format='*▲0.0%;▼0.0%;0.0%' name='[Calculation_1570348958062104583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Calculation_1570348958061527046] - .95) &gt;= 0&#13;&#10;THEN ([Calculation_1570348958061527046] - .95)&#13;&#10;END' />
      </column>
      <column caption='30. KPI Column' datatype='integer' name='[Calculation_1646347200166387729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(0)' />
      </column>
      <column caption='30. Anchor 2011SameMD' datatype='date' name='[Calculation_199002871378149377]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE(2011, MONTH(TODAY()), DAY(TODAY()))' />
      </column>
      <column caption='30. T|F 2011SameMD' datatype='boolean' name='[Calculation_199002871378493442]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATE([InvoiceDate]) &lt;= MAKEDATE(2011, MONTH(TODAY()), DAY(TODAY()))' />
      </column>
      <column caption='31. Net Revenue per Product YTD (_2011)' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[Calculation_199002871379718149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [TransactionCategory] = &quot;ValidSales&quot;&#13;&#10;    AND YEAR([InvoiceDate]) = 2011&#13;&#10;    AND [Calculation_199002871378493442]&#13;&#10;THEN [TotalValue]&#13;&#10;END' />
      </column>
