              <calculation class='tableau' formula='SUM(IF [IsUK (dim_geography.csv)] = 1&#13;&#10;THEN [TotalValue]&#13;&#10;END)&#13;&#10;//IIF([IsUK (dim_geography.csv)] = 1,  [01. Sales CY YTD], 0)&#13;&#10; / &#13;&#10; ([Calculation_1646347199960813572])' />
