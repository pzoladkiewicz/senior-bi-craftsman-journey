    <worksheet name='KPI Channel Score'>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_sales+' name='federated.1vbucgb1f0or7y11v3r3q02xzapd' />
          </datasources>
          <datasource-dependencies datasource='federated.1vbucgb1f0or7y11v3r3q02xzapd'>
            <column caption='07. UK Sales' datatype='real' default-format='p0%' name='[Calculation_1601029729426075648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([IsUK (dim_geography.csv)] * [Calculation_1646347199960813572]) &#13;&#10;/ &#13;&#10;{sum([Calculation_1646347199960813572])}' />
            </column>
            <column caption='07. Intl Sales' datatype='real' default-format='p0%' name='[Calculation_1601029729427025921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([Calculation_1601029729426075648])' />
            </column>
            <column caption='08. Guest Transactions' datatype='real' default-format='p0%' name='[Calculation_1601029729428357124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [CustomerType] = &quot;Guest&quot;&#13;&#10;    THEN [InvoiceNumber]&#13;&#10;    END&#13;&#10;)&#13;&#10;/ &#13;&#10;COUNT([InvoiceNumber])' />
            </column>
            <column caption='08. Registered Transactions' datatype='real' default-format='p0%' name='[Calculation_1601029729462673413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - [Calculation_1601029729428357124]' />
            </column>
            <column caption='10. Channel Score' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1601029729661317129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Channel Score (2011) = &#13;&#10;//VAR UKShare = [UK Sales Share % (2011)]&#13;&#10;//VAR IntlShare = 1 - UKShare&#13;&#10;//VAR GuestShare = [Guest Transactions % (2011)]&#13;&#10;//VAR RegisteredShare = 1 - GuestShare&#13;&#10;//RETURN&#13;&#10;//    (UKShare * 0.4) + (IntlShare * 0.3) + (RegisteredShare * 0.3)&#13;&#10;&#13;&#10;(SUM([Calculation_1601029729426075648]) * 0.4) + ([Calculation_1601029729427025921] * 0.3) + ([Calculation_1601029729462673413] * 0.3)' />
            </column>
            <column caption='01. 2011 YTD Sales' datatype='real' name='[Calculation_1646347199960813572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [_Anchor 2011SameMD (copy)_1646347199960289281] and YEAR([Date]) = 2011&#13;&#10;THEN [TotalValue]&#13;&#10;END' />
            </column>
            <column caption='KPI Column' datatype='integer' name='[Calculation_1646347200166387729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(0)' />
            </column>
            <column datatype='string' name='[CustomerType]' role='dimension' type='nominal' />
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[InvoiceNumber]' role='dimension' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[IsUK (dim_geography.csv)]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='n#,##0,K;-#,##0,K' name='[TotalValue]' role='measure' type='quantitative' />
            <column caption='_2011SameMD' datatype='boolean' name='[_Anchor 2011SameMD (copy)_1646347199960289281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Date] &lt;= MAKEDATE(2011, MONTH(TODAY()), DAY(TODAY()))' />
            </column>
            <column-instance column='[Calculation_1601029729661317129]' derivation='User' name='[usr:Calculation_1601029729661317129:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1646347200166387729]' derivation='User' name='[usr:Calculation_1646347200166387729:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
