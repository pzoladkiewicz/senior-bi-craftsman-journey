        <calculation class='tableau' formula='case ATTR([federated.14868jm04ibtmb11ma5k81urcdxs].[ComponentID])&#13;&#10;when 1 then SUM([Calculation_1601029729690677259])&#13;&#10;when 2 then SUM([Calculation_1601029729731395602])&#13;&#10;when 3 THEN SUM([Calculation_1601029729731833875])&#13;&#10;when 4 then SUM([Calculation_1601029729732395028])&#13;&#10;WHEN 5 THEN -SUM([Calculation_1601029729733251093])&#13;&#10;END' />
