            </column>
            <column caption='02. Sales PY YTD' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[01. Sales CY YTD (copy)_1058345976995577860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(INT([00. CY YTD (copy)_1058345976993832961]) * [TotalValue])' />
