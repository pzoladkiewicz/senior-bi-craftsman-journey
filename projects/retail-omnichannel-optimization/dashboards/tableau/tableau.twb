              <calculation class='tableau' formula='YEAR([InvoiceDate]) = YEAR(TODAY())&#13;&#10;AND &#13;&#10;DATE([InvoiceDate]) &lt;= TODAY()' />
            </column>
            <column caption='35.1 Product Transaction Volume' datatype='integer' name='[Calculation_1570348958287900681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [TransactionCategory] = &quot;ValidSales&quot;&#13;&#10;    THEN [StockCode]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='35.2 Product AOV' datatype='real' default-format='C2057%' name='[Calculation_1570348958288384010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_199002871379718149]&#13;&#10;/&#13;&#10;[Calculation_1570348958287900681]' />
            </column>
            <column caption='35.3 Volume vs Revenue Tier Colors' datatype='string' name='[Calculation_1570348958305333259]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_199002871379718149] &gt;= 20000  AND [Calculation_1570348958287900681] &gt;= 600 THEN &quot;stars&quot;&#13;&#10;ELSEIF [Calculation_199002871379718149] &gt;= 20000  AND [Calculation_1570348958287900681] &lt; 600 THEN &quot;premium&quot;&#13;&#10;ELSEIF  [Calculation_199002871379718149] &lt; 20000  AND [Calculation_1570348958287900681] &gt;= 600 THEN &quot;volume&quot;    &#13;&#10;ELSEIF [Calculation_199002871379718149] &lt; 20000  AND [Calculation_1570348958287900681] &lt; 600 THEN &quot;evaluate&quot;&#13;&#10;END' />
            </column>
            <column caption='31.1 Net Revenue per Product' datatype='real' default-format='c&quot;£&quot;#,##0,,.00M;-&quot;£&quot;#,##0,,.00M' name='[Calculation_199002871379718149]' role='measure' type='quantitative'>
