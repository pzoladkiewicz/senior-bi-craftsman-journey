            </column>
            <column caption='11.2 Volume Effect' datatype='real' name='[Calculation_1601029729731395602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//    (Qty2011 - Qty2010) * AvgPrice2010&#13;&#10;({SUM([01. 2011 YTD Sales (copy)_1601029729692434446])}  - {SUM([02. 2010 YTD Sales (copy)_1601029729692545039])})&#13;&#10;*&#13;&#10;{[01. 2011 YTD AVG Price (copy)_1601029729699966993]}' />
            </column>
            <column caption='11.3 Price Effect' datatype='real' name='[Calculation_1601029729731833875]' role='measure' type='quantitative'>
