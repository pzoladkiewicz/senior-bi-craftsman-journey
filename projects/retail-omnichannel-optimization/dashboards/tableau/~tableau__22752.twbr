      <column caption='03.KPI YoY Sales YTD CF (+)' datatype='real' default-format='*▲0.0%;▼0.0%;0.0%' name='[Calculation_1646347199968522250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1646347199966896136] &gt; 0 then [Calculation_1646347199966896136] end' />
