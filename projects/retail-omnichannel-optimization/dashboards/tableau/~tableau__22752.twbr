      <column caption='00. Anchor - 2011SameMD' datatype='date' name='[Calculation_1423981968018972672]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE(2011, MONTH(TODAY()), DAY(TODAY()))' />
