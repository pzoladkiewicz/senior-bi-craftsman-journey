	measure 'Sales 2011 (Up to Anchor)' =
			
			var Anchor = [1. Anchor Date (2011SameMD)]
			RETURN
			    CALCULATE(
			        [Total Sales],
			        FILTER(
			            dim_date,
			            YEAR(dim_date[Date]) = 2011 && dim_date[Date] <= Anchor)
