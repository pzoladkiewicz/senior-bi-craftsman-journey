	measure 'Country Sales Share by Month' =
			
			VAR CountryMonthlySales = [Total Sales]
			VAR TotalMonthlySales =
			            IF(
			                MAX(dim_date[Date]) <= [_. Anchor (_2011) Date (2011SameMD)] && YEAR(MAX(dim_date[Date])) = YEAR([_. Anchor (_2011) Date (2011SameMD)]),
			                CALCULATE(
			                    [Total Sales],
			                    dim_geography[IsUK] = 0,
			                    ALLSELECTED(dim_geography[Country])
			                    ,FILTER(
			                        dim_date,
			                        dim_date[Date] >= MIN(dim_date[Date]) &&
			                        dim_date[Date] <= max(dim_date[Date])
			                    )
			                ),
			                BLANK()
			            )
			RETURN
			    DIVIDE(CountryMonthlySales, TotalMonthlySales)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: 4f89c86f-3b4c-4b12-be33-451c045dce73

