	measure 'Operations Quality Index (_2011)' = ```
			
			VAR _anchor = [2. Anchor Date (2011SameMD) classified]
			VAR _validTransactions = 
			    CALCULATE(
			        COUNTA(fact_transactions_classified[Invoice]),
			        fact_transactions_classified[TransactionCategory] = "ValidSales",
			        YEAR(fact_transactions_classified[Date]) = YEAR(_anchor),
			        fact_transactions_classified[Date] <= _anchor
			    )
			VAR _qualityIssues = 
			    CALCULATE(
			        COUNTA(fact_transactions_classified[Invoice]),
			        fact_transactions_classified[TransactionCategory] IN {
			            "DataError",
			            "ManualAdjustment",
			            "Unclassified"
			        },
			        YEAR(fact_transactions_classified[Date]) = YEAR(_anchor),
			        fact_transactions_classified[Date] <= _anchor
			    )
			VAR _totalTransactions = _validTransactions + _qualityIssues
			RETURN
			    DIVIDE(_validTransactions, _totalTransactions, 1)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _2011_Anchor\Sales\transactions_classified
		lineageTag: 950f7cb5-397a-446f-a97a-532ed2e1ac02

