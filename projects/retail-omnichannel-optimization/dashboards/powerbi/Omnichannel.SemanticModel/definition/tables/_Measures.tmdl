		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 1) Data kotwicy: dzisiejszy miesiąc i dzień, rok = 2011 (przycięte do max daty 2011 w tabeli)
	measure '_. Anchor (_2011) Date (2011SameMD)' = ```
			
			    VAR AktualnyDzien = DATE(2011, MONTH(TODAY()), DAY(TODAY()))
			    var Max2011 = 
			        CALCULATE(
			            MAX(dim_date[Date]),
			            FILTER( ALL(dim_date), dim_date[Year] = 2011)
			        )
			    RETURN MIN(AktualnyDzien, Max2011)
			
			    //  Data kotwicy: dzisiejszy miesiąc i dzień, rok  2011 (przycięte do max daty 2011 w tabeli)
			```
		formatString: yyyy-mm-dd
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: 997661ff-f904-431d-a598-c82b0d071582

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure '01. Sales CY YTD' = TOTALYTD([Total Sales], dim_date[Date])
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: e1beeafd-5bc5-456c-a93f-515446593cc4

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Sales MTD (_2011)' =
			
			VAR _Anchor = [_. Anchor (_2011) Date (2011SameMD)]
			VAR _startDate = EOMONTH(_Anchor, -1) + 1
			RETURN
			    CALCULATE(
			        [Total Sales],
			        DATESBETWEEN(dim_date[Date],
			        _startDate,
			        _Anchor
			    )
			)
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: e6ef2945-4b07-481d-88d8-9d1259d42c1d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

