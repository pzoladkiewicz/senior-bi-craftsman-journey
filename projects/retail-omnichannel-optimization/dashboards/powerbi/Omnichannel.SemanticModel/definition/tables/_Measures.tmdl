			        )
			```
		displayFolder: fact_sales
		lineageTag: b552353f-c351-4ada-9646-ddaad37cfd19

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '03. Sales YoY %' =
			
			DIVIDE([01. Sales CY YTD] - [02. Sales PY YTD], [02. Sales PY YTD], 0)
		displayFolder: fact_sales
		lineageTag: 392aaa47-8df7-4bc0-a6ed-c78481e04df5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '04. Customers CY YTD' = ```
			
