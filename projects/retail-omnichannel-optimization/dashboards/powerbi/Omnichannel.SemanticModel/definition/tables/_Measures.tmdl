	measure 'Orders YTD (_2011)' =
			
			VAR _Anchor = [1. Anchor Date (2011SameMD)]
			VAR _dateStart = DATE(YEAR(_Anchor), 1, 1)
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(fact_sales[InvoiceNumber]),
			        DATESBETWEEN(
			            dim_date[Date],
			            _dateStart,
			            _Anchor
			        )
			    )
		formatString: 0
		lineageTag: 0f34dd8d-d391-4a38-b4f6-ebc7060b6bf0

