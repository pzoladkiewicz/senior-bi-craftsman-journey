			    [03. Sales YoY %] > 0, UNICHAR(11165) & " " & FORMAT([03. Sales YoY %], "0.0%"),
			    [03. Sales YoY %] < 0, UNICHAR(11167) & " " & FORMAT([03. Sales YoY %] * -1, "0.0%"),
			    FORMAT([03. Sales YoY %], "0.0%")
