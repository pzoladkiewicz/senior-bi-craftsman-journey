	measure '22.1 Guest Transactions %' =
			
			VAR _GuestCustomers =
			    CALCULATE(
			        [00. Transactions YTD],
			        dim_customer[CustomerType] = "Guest"
			    )
			
			RETURN
			    DIVIDE(_GuestCustomers, [00. Transactions YTD], 0)
		formatString: 0%;-0%;0%
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: b428c804-a6d5-4318-affc-a05b703fe687

	measure '23. Channel Score' =
			
			VAR UKShare = [21.1 UK Sales Share %]
			VAR IntlShare = 1 - UKShare
			VAR GuestShare = [22.1 Guest Transactions %]
			VAR RegisteredShare = 1 - GuestShare
			RETURN
			    (UKShare * 0.4) + (IntlShare * 0.3) + (RegisteredShare * 0.3)
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: e29fa000-6ce1-46e3-b135-d29a5d8a653f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '25.1 PY Base Revenue' = [02. Sales PY YTD]
		formatString: 0
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: cbaca7bb-5624-4532-919f-766fee44066d

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '25.2 CY Total Revenue' = [01. Sales CY YTD]
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: 87fcabb4-5ae9-4564-9757-f72fc92a236a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '25.3 Volume Effect' =
			
			VAR _CY_QTY = [00. Total Quantity CY YTD]
			VAR _PY_QTY = [00. Total Quantity PY YTD]
			VAR _PY_AvgPrice = DIVIDE([25.1 PY Base Revenue], _PY_QTY)
			RETURN
			    (_CY_QTY - _PY_QTY) * _PY_AvgPrice
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: f629cb91-2061-48eb-8cb1-bbf323043ada

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '25.4 Price Effect' =
			
			VAR _CY_QTY = [00. Total Quantity CY YTD]
			VAR _PY_QTY = [00. Total Quantity PY YTD]
			VAR _PY_AVGPrice = DIVIDE([25.1 PY Base Revenue], _PY_QTY)
			VAR _CY_AVGPrice = DIVIDE([25.2 CY Total Revenue], _CY_QTY)
			RETURN
			    _CY_QTY * (_CY_AVGPrice - _PY_AVGPrice)
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: f9076c6b-b02e-4cd0-b468-27f54999dc42

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '25.5 Mix Effect' =
			
			VAR _TotalCalculated = [25.1 PY Base Revenue] + [25.3 Volume Effect] + [25.4 Price Effect]
			VAR _ActualTotal = [25.2 CY Total Revenue]
			RETURN
			    _ActualTotal - _TotalCalculated
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: 87d84886-223e-4475-a4fc-cfe2b7b729e5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '25.6 Waterfall Value' = ```
			
			SWITCH(
			    SELECTEDVALUE('WaterfallCategories Table'[Category]),
			    "PY Base Revenue", [25.1 PY Base Revenue],
			    "Volume Effect", [25.3 Volume Effect],
			    "Price Effect", [25.4 Price Effect], 
			    "Mix Effect", [25.5 Mix Effect],
			    "CY Total Revenue", [25.2 CY Total Revenue],
			    0
			)
			```
		formatString: 0
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: 7c6fbb7e-4ca2-4f99-a9b7-f7c8765b19c2

