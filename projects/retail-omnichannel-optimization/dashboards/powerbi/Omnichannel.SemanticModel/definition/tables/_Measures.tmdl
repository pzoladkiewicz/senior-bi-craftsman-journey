	measure '01. Sales CY YTD' = TOTALYTD([00. Total Sales], dim_date[Date])
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: fact_sales
		lineageTag: e1beeafd-5bc5-456c-a93f-515446593cc4

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure '02. Sales PY YTD' = ```
			
			    CALCULATE(
			        [01. Sales CY YTD],
