			        [00. Monthly Sales CY],
			        dim_geography[IsUK] = 0
			    )
			VAR _Total = 
			    CALCULATE(
			        [00. Monthly Sales CY],
			        dim_geography[IsUK] = 0,
			        REMOVEFILTERS(dim_customer[Country]),
			        REMOVEFILTERS(dim_geography[Country Group])
			    )
			
			RETURN
			    IF(
			        _Total > 0,
			        DIVIDE(_NoUK, _Total),
			        BLANK()
			    )
