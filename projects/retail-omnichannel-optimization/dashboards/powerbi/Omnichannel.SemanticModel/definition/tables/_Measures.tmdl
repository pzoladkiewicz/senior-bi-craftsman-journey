	measure 'Sales PM (2011 Anchor)' =
			
			VAR Anchor = [1. Anchor Date (2011SameMD)]
			VAR StartPrevMonth = EOMONTH(Anchor, -2) +1
			VAR EndPrevMonth = EOMONTH(Anchor, -1)
			RETURN
			    CALCULATE(
