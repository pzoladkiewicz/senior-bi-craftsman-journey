	measure 'New Customers (_2011)' = ```
			
			VAR _Anchor = [1. Anchor Date (2011SameMD)]
			VAR _currentYear = MAX(dim_date[Year])
			RETURN
			IF(
			    MAX(dim_date[Date]) <= _Anchor && _currentYear = YEAR(_Anchor),
			        CALCULATE(
			            DISTINCTCOUNT(dim_customer[CustomerKey]),
			            FILTER(
			                dim_customer,
			                dim_customer[FirstPurchase] >= MIN(dim_date[Date]) &&
			                dim_customer[FirstPurchase] <= MAX(dim_date[Date])
			            )
			        ),
			    BLANK()
			)
			
			/*
			New Customers (_2011) = 
			// poniżej dla przypadku, gdy operujemy na danych aktualnych
			// a nie jak w tym projekcie - archiwalnych
			CALCULATE(
			    DISTINCTCOUNT(dim_customer[CustomerKey]),
			    FILTER(
			        dim_customer,
			        dim_customer[FirstPurchase] >= MIN(dim_date[Date]) &&
			        dim_customer[FirstPurchase] <= MAX(dim_date[Date])
			    )
			)
			*/
			```
		formatString: 0
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: a8d0cc1c-ef2b-42a0-9145-7e6ecb9374d7

	measure 'Returning Customers (_2011)' =
			
			VAR _Anchor = [1. Anchor Date (2011SameMD)]
			VAR _CurrentDate = MAX(dim_date[Date])
			VAR _PeriodStart = MIN(dim_date[Date])
			VAR _PeriodEnd = MIN(_CurrentDate, _Anchor)
			RETURN
			IF(
			    _CurrentDate <= _Anchor && YEAR(_CurrentDate) = YEAR(_Anchor),
			    CALCULATE(
			        DISTINCTCOUNT(fact_sales[CustomerKey]),  // ← Liczymy z fact_sales!
			        dim_customer[FirstPurchase] < DATE(YEAR(_Anchor), 1, 1),  // Before anchor year
			        dim_date[Date] >= _PeriodStart,    // Date filters
			        dim_date[Date] <= _PeriodEnd       // propagate to fact_sales
			    ),
			    BLANK()
			)
			
			
			
			/*
			
			    // poniżej dla przypadku, gdy operujemy na danych aktualnych
			    // a nie jak w tym projekcie - archiwalnych
			
			VAR _minDate = MIN(dim_date[Date])
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(dim_customer[CustomerKey]),
			    FILTER(
			        dim_customer,
			        dim_customer[FirstPurchase] < _minDate &&
			        COUNTROWS(RELATEDTABLE(fact_sales)) > 0
			    )
			)
			
			*/
		formatString: 0
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: 4d9689ce-2c39-4510-ab3a-7394a0427129

	measure 'UK Sales Share % (2011)' =
			
			VAR Anchor = [1. Anchor Date (2011SameMD)]
			VAR UKSales =
			    CALCULATE(
			        [Total Sales],
			        dim_geography[IsUK] = 1,
			        dim_date[Year] = YEAR(Anchor),
			        dim_date[Date] <= Anchor
			    )
			VAR TotalSales =
			    CALCULATE(
			        [Total Sales],
			        dim_date[Year] = YEAR(Anchor),
			        dim_date[Date] <= Anchor
			    )
			RETURN
			    DIVIDE(UKSales, TotalSales)
		formatString: 0%;-0%;0%
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: c8f171f3-71ec-481a-b4d6-fe99d1f78077

	measure 'Intl Sales Share % (2011)' = 1 - [UK Sales Share % (2011)]
		formatString: 0%;-0%;0%
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: 7f5ca795-51ec-4cef-aa12-c75b2451c504

	measure 'Guest Transactions % (2011)' =
			
			VAR Anchor = [1. Anchor Date (2011SameMD)]
			VAR GuestCustomers =
			    CALCULATE(
			        COUNTROWS(fact_sales),
			        dim_customer[CustomerType] = "Guest",
			        dim_date[Year] = YEAR(Anchor),
			        dim_date[Date] <= Anchor
			    )
			VAR TotalCustomers =
			    CALCULATE(
			        COUNTROWS(fact_sales),
			        dim_date[Year] = YEAR(Anchor),
			        dim_date[Date] <= Anchor
			    )
			RETURN
			    DIVIDE(GuestCustomers, TotalCustomers)
		formatString: 0%;-0%;0%
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: b428c804-a6d5-4318-affc-a05b703fe687

	measure 'Channel Score (2011)' =
			
			VAR UKShare = [UK Sales Share % (2011)]
			VAR IntlShare = 1 - UKShare
			VAR GuestShare = [Guest Transactions % (2011)]
			VAR RegisteredShare = 1 - GuestShare
			RETURN
			    (UKShare * 0.4) + (IntlShare * 0.3) + (RegisteredShare * 0.3)
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: e29fa000-6ce1-46e3-b135-d29a5d8a653f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '2010 Base Revenue' = [Sales YTD PY (_2010)]
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: cbaca7bb-5624-4532-919f-766fee44066d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '2011 Total Revenue' = [Sales YTD (_2011)]
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: 87fcabb4-5ae9-4564-9757-f72fc92a236a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume Effect' =
			
			VAR Anchor = [1. Anchor Date (2011SameMD)]
			VAR Qty2011 =
			    CALCULATE(
			        [Total Quantity],
			        dim_date[Year] = YEAR(Anchor),
			        dim_date[Date] <= Anchor
			    )
			VAR Qty2010 =
			    CALCULATE(
			        [Total Quantity],
			        dim_date[Year] = YEAR(EDATE(Anchor, -12)),
			        dim_date[Date] <= EDATE(Anchor, -12)
			    )
			VAR AvgPrice2010 =
			    DIVIDE([2010 Base Revenue], Qty2010)
			RETURN
			    (Qty2011 - Qty2010) * AvgPrice2010
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: f629cb91-2061-48eb-8cb1-bbf323043ada

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Price Effect' =
			
			VAR Anchor = [1. Anchor Date (2011SameMD)]
			VAR Qty2011 =
			    CALCULATE(
			        [Total Quantity],
			        dim_date[Year] = YEAR(Anchor),
			        dim_date[Date] <= Anchor
			    )
			VAR Qty2010 =
			    CALCULATE(
			        [Total Quantity],
			        dim_date[Year] = YEAR(EDATE(Anchor, -12)),
			        dim_date[Date] <= EDATE(Anchor, -12)
			    )
			VAR AvgPrice2010 =
			    DIVIDE([2010 Base Revenue], Qty2010)
			VAR AvgPrice2011 =
			    DIVIDE([2011 Total Revenue], Qty2011)
			RETURN
			    Qty2011 * (AvgPrice2011 - AvgPrice2010)
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: f9076c6b-b02e-4cd0-b468-27f54999dc42

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Mix Effect' =
			
			VAR TotalCalculated = [2010 Base Revenue] + [Volume Effect] + [Price Effect]
			VAR ActualTotal = [2011 Total Revenue]
			RETURN
			    ActualTotal - TotalCalculated
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: 87d84886-223e-4475-a4fc-cfe2b7b729e5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Waterfall Value' = ```
			
			SWITCH(
			    SELECTEDVALUE('WaterfallCategories Table'[Category]),
			    "2010 Base Revenue", [2010 Base Revenue],
			    "Volume Effect", [Volume Effect],
			    "Price Effect", [Price Effect], 
			    "Mix Effect", [Mix Effect],
			    "2011 Total Revenue", [2011 Total Revenue],
			    0
			)
			```
		displayFolder: _2011_Anchor\Sales\Charts\Waterfall
		lineageTag: 7c6fbb7e-4ca2-4f99-a9b7-f7c8765b19c2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Quantity YTD (2011)' = ```
			
