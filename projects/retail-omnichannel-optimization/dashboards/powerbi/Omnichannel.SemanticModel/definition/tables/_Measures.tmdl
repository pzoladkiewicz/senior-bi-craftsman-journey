	measure '39. Product AOV' = DIVIDE([31. Net Revenue per Product CY YTD], [38. Product Transaction Volume], 0)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: transactions_classified
		lineageTag: 31df0272-51d0-49d8-b31f-99f0babb3ba0

