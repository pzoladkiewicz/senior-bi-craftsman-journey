	measure '_slicer Sales YoY% CF' =
			
			SWITCH(
			    TRUE(),
			    [_slicer - Sales YoY (_2011)] > 0, "Green",
			    [_slicer - Sales YoY (_2011)] < 0, "Red",
			    "Grey")
