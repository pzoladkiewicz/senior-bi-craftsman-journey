	measure 'Intl Growth Rate % formated' =
			
			SWITCH(
			    TRUE(),
			    [Intl Growth Rate] > 0, "+" &FORMAT([Intl Growth Rate], "0.0%"),
			    [Intl Growth Rate] < 0, "-" &FORMAT([Intl Growth Rate], "0.0%"),
			    FORMAT([Intl Growth Rate], "0.0%"))
		lineageTag: 5392eb92-0bc9-4d78-8e58-cb42accb94b2

	measure '_slicer - Sales YTD (_2011)' = ```
			
			VAR _customerSelection = SELECTEDVALUE('_slicer Customer Segment - Executive Summary'[CustomerTypeFilter], "All Customers")
			VAR _filterCondition = 
			    SWITCH(
			        _customerSelection,
			        "All Customers", [Sales YTD (_2011)],
			        "Registered Only", CALCULATE(
			            [Sales YTD (_2011)], dim_customer[CustomerType] = "Registered"
			            ),
			        "Guest Only", CALCULATE(
			            [Sales YTD (_2011)], dim_customer[CustomerType] = "Guest"
			        ), 
			        [Sales YTD (_2011)]
			    )
			RETURN
			    _filterCondition
			```
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: f9f2c659-af5f-44a7-bed7-9c46d4a7faad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'International Market Share' = ```
			
			VAR _anchor = [1. Anchor Date (2011SameMD)]
			
			VAR _total = 
			    CALCULATE(
			        SUM(fact_sales[TotalValue]),
			        dim_geography[IsUK] = 0,
			        REMOVEFILTERS(dim_geography[Country Group]
			        )
			    )
			VAR _group = SUM(fact_sales[TotalValue])
			RETURN
			    IF(
			        MAX(dim_date[Date]) <= _anchor && MAX(dim_date[Year]) = YEAR(_anchor),
			        DIVIDE(_group, _total),
			        BLANK()
			    )
			```
		formatString: 0%;-0%;0%
		lineageTag: e58fb0bf-707e-4d2c-8e2d-b317b304c7e0

