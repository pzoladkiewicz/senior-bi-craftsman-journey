	measure 'vs Last Month' = ```
			
			SWITCH(
			    TRUE(),
			    [Sales MoM MTD % (2011 Anchor)] > 0, UNICHAR(11165) & " " & FORMAT([Sales MoM MTD % (2011 Anchor)], "0.0%"),
			    [Sales MoM MTD % (2011 Anchor)] < 0, UNICHAR(11167) & " " & FORMAT([Sales MoM MTD % (2011 Anchor)] * -1, "0.0%"),
			    FORMAT([Sales MoM MTD % (2011 Anchor)], "0.0%")
			)
			
			
