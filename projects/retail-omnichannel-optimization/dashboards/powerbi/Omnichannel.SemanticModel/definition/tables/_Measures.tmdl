	measure '34. Operations Quality Index' = ```
			
			
			VAR _validTransactions = 
			    CALCULATE(
			        COUNTA(fact_transactions_classified[Invoice]),
			        fact_transactions_classified[TransactionCategory] = "ValidSales",
			        DATESYTD(fact_transactions_classified[Date])
			    )
			VAR _qualityIssues = 
			    CALCULATE(
			        COUNTA(fact_transactions_classified[Invoice]),
			        fact_transactions_classified[TransactionCategory] IN {
			            "DataError",
			            "ManualAdjustment",
			            "Unclassified"
			        },
			        DATESYTD(fact_transactions_classified[Date])
			    )
			VAR _totalTransactions = _validTransactions + _qualityIssues
			RETURN
			    DIVIDE(_validTransactions, _totalTransactions, 1)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: transactions_classified
		lineageTag: 950f7cb5-397a-446f-a97a-532ed2e1ac02

	measure '35. Quality Cost Impact' = ```
			
			    CALCULATE(
			        ABS(SUM(fact_transactions_classified[TotalValue])),
			        fact_transactions_classified[TransactionCategory] IN {
			            "ManualAdjustment",
			            "Unclassified"
			        },
			        DATESYTD(fact_transactions_classified[Date])
			    )
			```
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		displayFolder: transactions_classified
		lineageTag: 0bc331bb-6bfe-4284-ac31-70502f4d71bf

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure '37. Efficiency Gap' = ```
			
			 VAR _gap = [36. Business Efficiency] - .95
