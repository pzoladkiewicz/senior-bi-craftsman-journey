	measure 'Intl Growth Rate' = ```
			
			VAR _anchor = [1. Anchor Date (2011SameMD)]
			VAR _anchorPY = EDATE(_anchor, -12)
			VAR _ytd =
			    CALCULATE(
			        [Total Sales],
			        dim_geography[IsUK] = 0,
			        dim_date[Year] = YEAR(_anchor),
			        dim_date[Date] <= _anchor
			    )
			VAR _py = 
			    CALCULATE(
			        [Total Sales],
			        dim_geography[IsUK] = 0,
			        dim_date[Year] = YEAR(_anchorPY),
			        dim_date[Date] <= _anchorPY
			    )
			return
			    (_ytd / _py) - 1
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: 5169abd9-ece4-44dd-961e-a02a8c46842c

