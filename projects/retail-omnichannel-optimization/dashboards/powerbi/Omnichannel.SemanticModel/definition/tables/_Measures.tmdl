	measure '39.1 Products Positioning Tier Colors' = ```
			
			    VAR _revenue = [31. Net Revenue per Product CY YTD]
			    VAR _volume = [38. Product Transaction Volume]
			    VAR _highRevenue = _revenue >= 20000
			    VAR _highVolume = _volume >= 600
			    RETURN 
			        SWITCH(
			            TRUE(),
			            _highRevenue && _highVolume, "#1f7a1f",         -- stars
			            _highRevenue && NOT(_highVolume), "#1f4e79",    -- premium
			            NOT(_highRevenue) && _highVolume, "#d67e00",    -- volume
			            "#767676"
			        )
			```
		displayFolder: transactions_classified
		lineageTag: 39fa1629-5c4a-45ed-b8e1-9035fc05a05d

	measure '41. Return rate CF color' = ```
			
			    SWITCH(
			        TRUE(),
			        [33. Return rate] > .05, "Red",
			        [33. Return rate] > .02, "Orange",
			        "#333333")
			```
		displayFolder: transactions_classified
		lineageTag: ed14f3e5-88be-419f-9d12-72378f0fa425

	measure '40. AOV vs. Volume Tier Colors' = ```
			
			VAR _aov = [39. Product AOV]
			VAR _volume = [38. Product Transaction Volume]
			VAR _highAOV = _aov >= 50
			VAR _highVolume = _volume >= 600
			RETURN 
			    SWITCH(
			        TRUE(),
			        _highAOV && _highVolume, "#1f7a1f",         -- green    -- Premium Mass Market
			        _highAOV && NOT(_highVolume), "#1f4e79",    -- blue     -- Niche Premium
			        NOT(_highAOV) && _highVolume, "#d67e00",    -- orange   -- Volume Leaders
			        "#767676"                                   -- grey     -- Evaluate
			    )
			```
		displayFolder: transactions_classified
		lineageTag: 8d11778f-0aa4-4180-86f5-9e5b9b932b38

	measure '00. Monthly Sales CY' = ```
			
