	measure 'Sales MTD PM (2011 Anchor)' = ```
			
			var Anchor = [1. Anchor Date (2011SameMD)]
			VAR StartPrevMonth = EOMONTH(Anchor, -2) + 1
			VAR StopDate = EDATE(Anchor, -1)
			RETURN
			    CALCULATE(
			        [Total Sales],
			        DATESBETWEEN(
			            dim_date[Date],
			            StartPrevMonth,
			            StopDate)
