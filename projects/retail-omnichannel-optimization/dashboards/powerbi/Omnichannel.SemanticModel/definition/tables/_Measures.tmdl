	measure '16. New Customers CY' = ```
			
			IF (
			    MAX(dim_date[Year]) = YEAR(TODAY()) && MAX(dim_date[Month]) <= MONTH(TODAY()),
			    CALCULATE(
			        DISTINCTCOUNT(dim_customer[CustomerKey]),
			        FILTER(
			            dim_customer,      
			            YEAR(dim_customer[FirstPurchase]) = YEAR(TODAY()) &&
			            MONTH(dim_customer[FirstPurchase]) = MAX(dim_date[Month]) &&
			            dim_customer[FirstPurchase] <= TODAY()
			        )
			    ),
			    BLANK()
			)
			```
		formatString: 0
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: a8d0cc1c-ef2b-42a0-9145-7e6ecb9374d7

	measure '17. Returning Customers CY' = ```
			
			VAR _rowMonth = MONTH(MAX(dim_date[Date]))
			VAR _rowYear = YEAR(MAX(dim_date[Date]))
			RETURN
			IF(
			    _rowYear = YEAR(TODAY()) && MAX(dim_date[Date]) <= TODAY(),
			    CALCULATE(
			        DISTINCTCOUNT(fact_sales[CustomerKey]),
			        dim_date[Month] = _rowMonth,
			        dim_date[Year] = _rowYear,
			        FILTER(
			            dim_customer,
			            YEAR(dim_customer[FirstPurchase]) < _rowYear ||
			            (YEAR(dim_customer[FirstPurchase]) = _rowYear && 
			             MONTH(dim_customer[FirstPurchase]) < _rowMonth)
			        )
			    ),
			    BLANK()
			)
			```
		formatString: 0
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: 4d9689ce-2c39-4510-ab3a-7394a0427129

	measure '21.1 UK Sales Share %' =
			
			VAR UKSales =
			    CALCULATE(
			        [01. Sales CY YTD],
			        dim_geography[IsUK] = 1
			    )
			VAR TotalSales = [01. Sales CY YTD]
			RETURN
			    DIVIDE(UKSales, TotalSales)
