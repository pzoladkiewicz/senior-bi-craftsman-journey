	measure '07. AOV CY YTD' = ```
			
			VAR _InvoiceCount = 
			    CALCULATE(
			        DISTINCTCOUNT(fact_sales[InvoiceNumber]),
			        DATESYTD(dim_date[Date])
			    )
			RETURN
			DIVIDE([01. Sales CY YTD], _InvoiceCount, 0)
