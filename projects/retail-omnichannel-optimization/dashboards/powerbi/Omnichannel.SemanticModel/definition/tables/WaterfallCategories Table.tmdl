table 'WaterfallCategories Table'
	lineageTag: e8c1e303-c595-4efd-b671-ace9a1eb5f00

	measure 'Sales YTD Anchor' =
			
			VAR Anchor = [1. Anchor Date (2011SameMD)]
			VAR RowYear = YEAR(MAX(dim_date[Date]))
			var RowDate = MAX(dim_date[Date])
			RETURN
			    IF(
			        RowYear = YEAR(Anchor) && RowDate <= Anchor,
			        [Total Sales],
			        BLANK()
			    )
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: 7a4d27ee-0e25-4e0f-b90b-cef213b6f2e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _dataMniejszaNizAnchor = IF(MAX(dim_date[Date]) <= [1. Anchor Date (2011SameMD)], 1, 0)
		formatString: 0
		lineageTag: 475efd32-742e-41c2-87db-b20eb62b7f6e

	column Category
		lineageTag: 3498cffb-3f58-44c5-a26a-dc5d3acb6851
		summarizeBy: none
		isNameInferred
		sourceColumn: [Category]
		sortByColumn: SortOrder

		annotation SummarizationSetBy = Automatic

	column SortOrder
		formatString: 0
		lineageTag: 5ef30da2-73fc-4896-b54c-902b2384f76a
		summarizeBy: none
		isNameInferred
		sourceColumn: [SortOrder]

		annotation SummarizationSetBy = User

	partition 'WaterfallCategories Table' = calculated
		mode: import
		source = ```
				
				DATATABLE(
				    "Category", STRING,
				    "SortOrder", INTEGER,
				    {
				        {"2010 Base Revenue", 1},
				        {"Volume Effect", 2},
				        {"Price Effect", 3},
				        {"Mix Effect", 4},
				        {"2011 Total Revenue", 5}
				    }
				)
				
				```

	annotation PBI_Id = ee7dcbed8b854bac8a6da170f883f588

