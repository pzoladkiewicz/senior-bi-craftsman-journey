table 'WaterfallCategories Table'
	lineageTag: e8c1e303-c595-4efd-b671-ace9a1eb5f00

	measure 'Sales YTD Anchor' =
			
			VAR Anchor = [1. Anchor Date (2011SameMD)]
			VAR RowYear = YEAR(MAX(dim_date[Date]))
			var RowDate = MAX(dim_date[Date])
			RETURN
			    IF(
			        RowYear = YEAR(Anchor) && RowDate <= Anchor,
			        [Total Sales],
			        BLANK()
			    )
		displayFolder: _2011_Anchor\Sales\Time Intelligence
		lineageTag: 7a4d27ee-0e25-4e0f-b90b-cef213b6f2e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AOV (2011 YTD) 2' = ```
			
			VAR _Anchor = [1. Anchor Date (2011SameMD)]
			VAR _startDate = DATE(YEAR(_Anchor), 1, 1)
			RETURN
			DIVIDE([Sales YTD (_2011)], 
			       CALCULATE(DISTINCTCOUNT(fact_sales[InvoiceNumber]),
			           DATESBETWEEN(dim_date[Date],
			           _startDate,
			           _Anchor
			           )
			       )
			)
			```
		lineageTag: 52219f81-3135-4f86-8eec-ef5cdbfcea9d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AOV PY (2011 YTD) 2' = ```
			
			VAR _Anchor = EDATE([1. Anchor Date (2011SameMD)], -12)
			VAR _startDate = DATE(YEAR(_Anchor), 1, 1)
			RETURN
			DIVIDE([Sales YTD PY (_2010)], 
			       CALCULATE(DISTINCTCOUNT(fact_sales[InvoiceNumber]),
			           DATESBETWEEN(dim_date[Date],
			           _startDate,
			           _Anchor
			           )
			       )
			)
			```
		lineageTag: 45e1c248-1d93-4534-ae54-1d854d002861

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Category
		lineageTag: 3498cffb-3f58-44c5-a26a-dc5d3acb6851
		summarizeBy: none
		isNameInferred
		sourceColumn: [Category]
