table _Measures
	lineageTag: 703fd2a7-2cbd-4370-8991-c18dfce70120

	measure '01. Revenue' = SUM('dwh v_Order_TimeSeries'[TotalRevenue])
		lineageTag: a8a7b211-4a47-425d-9500-e83fe70d8725

		formatStringDefinition = pbi.NumberFormat()

	measure '11.1 Revenue PY' = ```
			
			    CALCULATE(
			        [01. Revenue],
			        SAMEPERIODLASTYEAR('dwh D_Date'[Date])
			    )
			```
		lineageTag: d120827d-57ab-4fc9-b5a9-b015b9f1a546

		formatStringDefinition = pbi.NumberFormat()

	measure '11.2 Revenue YoY %' = ```
			
			VAR _CY = [01. Revenue]
			VAR _PY = [11.1 Revenue PY]
			RETURN
			    IF(ISBLANK(_PY), BLANK(), DIVIDE(_CY - _PY, _PY)) 
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a600a5d1-52cd-4def-9d1a-e06670fe0a9f

	measure '11.3 CF Revenue YoY %' =
			
			VAR _CY = [01. Revenue]
			VAR _PY = [11.1 Revenue PY]
			VAR _perc = DIVIDE(_CY - _PY, _PY)
			RETURN
			    SWITCH(
			        TRUE(),
			        _perc > 0, pbi.ThemeColor("pos"),
			        _perc < 0, pbi.ThemeColor("neg"),
			        "Grey"
			        )
		lineageTag: 0a6ec2db-3a06-4100-8cfc-27cdf84652c5

	measure '02. Profit' = SUM('dwh v_Order_TimeSeries'[TotalProfit])
		lineageTag: 7dcb2d46-86ba-4851-87e0-d77016471557

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '12.1 Profit Margin' = DIVIDE([02. Profit] , [01. Revenue], 0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 72c40f60-0c6c-4178-9d24-b757c112cb25

	measure '12.2 CF Profit Margin' = ```
			
			    SWITCH(
			        TRUE(),
			        [12.1 Profit Margin] > 0, pbi.ThemeColor("pos"),
			        [12.1 Profit Margin] < 0, pbi.ThemeColor("neg"),
			        "Grey"
			        )
			```
		lineageTag: 3428f26d-7561-447c-bb29-a539c132f4ff

	measure '03. Orders' = SUM('dwh v_Order_TimeSeries'[OrderCount])
		formatString: 0
		lineageTag: 6d5c64a3-1516-4e11-a7a4-3fde60814f56

	measure '13.1 Orders PY' = ```
			
			    CALCULATE(
			        [03. Orders],
			        SAMEPERIODLASTYEAR('dwh D_Date'[Date])
			    )
			```
		formatString: 0
		lineageTag: fe82e876-f3a3-4d24-86a6-055032534dcc

	measure '13.2 Orders YoY %' = ```
			
			VAR _CY = [03. Orders]
			VAR _PY = [13.1 Orders PY]
			RETURN
			    IF(ISBLANK(_PY), BLANK(), DIVIDE(_CY - _PY, _PY)) 
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a9e3eaf8-108e-4682-8682-e7f914c7e72d

	measure '13.3 CF Orders YoY %' =
			
			VAR _CY = [03. Orders]
			VAR _PY = [13.1 Orders PY]
			VAR _perc = DIVIDE(_CY - _PY, _PY)
			RETURN
			    SWITCH(
			        TRUE(),
			        _perc > 0, pbi.ThemeColor("pos"),
			        _perc < 0, pbi.ThemeColor("neg"),
			        "Grey"
			        )
		lineageTag: 60dbc6bd-d972-4ad0-af61-f45b0dd0a88d

	measure '04. Avg Shipping Days' = ```
			
			VAR _TotalDays = 
			    SUMX(
			        'dwh v_Shipping_KPI',
			        'dwh v_Shipping_KPI'[AvgShipDays] * 'dwh v_Shipping_KPI'[DeliveryCount]
			        )
			VAR _TotalCount = SUM('dwh v_Shipping_KPI'[DeliveryCount])
			RETURN
			    DIVIDE(_TotalDays, _TotalCount, 0)
			```
		formatString: 0.0
		lineageTag: 4112e3f3-fd77-4a98-8595-9bcec4963499

	measure '14.1 Shipping Variance' = [04. Avg Shipping Days] - 4.0
		formatString: #,0.0
		lineageTag: 5e79a549-cefd-4c83-aeae-26a326df1a0a

	measure '14.2 CF Shipping vs. Target' = ```
			
			    SWITCH(
			        TRUE(),
			        [14.1 Shipping Variance] < 0, pbi.ThemeColor("pos"),
			        [14.1 Shipping Variance] > 0, pbi.ThemeColor("neg"),
			        "Grey"
			        )
			```
		lineageTag: 8523278d-5b37-4ed9-97a9-ecb6637ee62a

	measure '17.1 Margin %' = ```
			
			    DIVIDE(
			        SUM('dwh v_Product_Performance'[Profit]),
			        SUM('dwh v_Product_Performance'[Revenue]),
			        0
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9b0bf90e-f58a-4732-b27a-ce20e99531c8

	measure '12.3 Profit Margin Last Value' =
			
			VAR _LastMonth = CALCULATE(MAX('dwh D_Date'[Month]), ALL('dwh D_Date'))
			RETURN
			    IF(
			        SELECTEDVALUE('dwh D_Date'[Month]) = _LastMonth,
			            [12.1 Profit Margin],
			            BLANK()
			    )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ae4ca2c3-62ff-4c91-96f8-7b50343f9e2a

	measure '21.1 Total Customers' = DISTINCTCOUNT('dwh v_Customer_Summary'[CustomerKey])
		lineageTag: 11e823ac-6081-4ea4-92c8-1e3b458e2d29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '24.1 Avg CLV per Customer' = ```
			
			    DIVIDE(
			        SUM('dwh v_Customer_Summary'[CLV]),
			        DISTINCTCOUNT('dwh v_Customer_Summary'[CustomerKey])
			    )
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: e835af14-3a56-4a18-9832-98bd0970bfa6

	measure '23.1 Avg Orders per Customer' = ```
			
			    DIVIDE(
			            SUM('dwh v_Customer_Summary'[TotalOrders]),
			            DISTINCTCOUNT('dwh v_Customer_Summary'[CustomerKey])
			    )
			```
		lineageTag: c2704bbe-811b-455f-a3a3-5de1c629b8ca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '20.4 Total Revenue' = SUM('dwh v_Customer_Summary'[TotalRevenue])
		lineageTag: 67fdc828-c61e-4ab0-ae99-cddcb3fb49dd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '20.5 Total Profit' = SUM('dwh v_Customer_Summary'[TotalProfit])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a162d8ed-aa4b-4c03-b7d5-41b6cd2d6f7d

	measure '25.1 Profit Margin %' = ```
			
			    DIVIDE(
			        [20.5 Total Profit],
			        [20.4 Total Revenue],
			        0
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e220258a-44cd-4904-8977-2e661655b1d3

	measure '25.2 CF Profit Margin %' =
			
			VAR _m = [25.1 Profit Margin %]
			RETURN
			    SWITCH(
			        TRUE(),
			        _m < 0, "red",
			        "#333"
			    )
		lineageTag: ed33a6ad-35e8-40b9-9fe4-d06aded3a3f8

	measure '25.3 CF Total Profit' =
			
			VAR _m = [20.5 Total Profit]
			RETURN
			    SWITCH(
			        TRUE(),
			        _m < 0, "red",
			        "#333"
			    )
		lineageTag: bfe95e88-2652-4bf4-bc09-0aea996f60d5

