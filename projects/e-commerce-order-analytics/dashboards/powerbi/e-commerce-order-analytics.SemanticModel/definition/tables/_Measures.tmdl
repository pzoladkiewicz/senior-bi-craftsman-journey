	measure '20.5 Total Profit' = SUM('dwh v_Customer_Summary'[TotalProfit])
		lineageTag: a162d8ed-aa4b-4c03-b7d5-41b6cd2d6f7d

		formatStringDefinition = pbi.CurrencyFormat()

	measure '25.1 Profit Margin %' = ```
			
			    DIVIDE(
			        [20.5 Total Profit],
			        [20.4 Total Revenue],
			        0
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e220258a-44cd-4904-8977-2e661655b1d3

	measure '25.2 CF Profit Margin %' =
			
			VAR _m = [25.1 Profit Margin %]
			RETURN
			    SWITCH(
			        TRUE(),
			        _m < 0, "red",
			        "#333"
			    )
		lineageTag: ed33a6ad-35e8-40b9-9fe4-d06aded3a3f8

	measure '25.3 CF Total Profit' =
			
			VAR _m = [20.5 Total Profit]
			RETURN
			    SWITCH(
			        TRUE(),
			        _m < 0, "red",
			        "#333"
			    )
		lineageTag: bfe95e88-2652-4bf4-bc09-0aea996f60d5

	measure '31.1 Total Product Revenue' = SUM('dwh v_Product_Performance'[Revenue])
		lineageTag: 971c05ed-3c57-4ba9-acd8-41aaca4120d3

		formatStringDefinition = pbi.CurrencyFormat()

	measure '32.1 Total Products' = DISTINCTCOUNT('dwh v_Product_Performance'[ProductKey])
		formatString: 0
		lineageTag: bab824c7-0ea2-4289-961b-6460e617bbfc

	measure '33.1 Avg Profit Margin %' = ```
			
			    DIVIDE(
			        SUM('dwh v_Product_Performance'[Profit]),
			        SUM('dwh v_Product_Performance'[Revenue]),
			        0
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7233c1bb-8a53-4452-8470-a6d06b1e730b

	measure '17.2 Revenue' = SUM('dwh v_Product_Performance'[Revenue])
		lineageTag: 7e4633bf-936e-4b4b-9de3-487db9d7d0aa

		formatStringDefinition = pbi.CurrencyFormat()

	measure '17.3 CF Margin %' =
			
			VAR _m = [17.1 Margin %]
			RETURN
			    SWITCH(
			        TRUE(),
			        _m >= 0.11, "green",
			        _m >= 0.10 && _m < 0.11, "orange",
			        _m < 0.10, "red"
			    )
		lineageTag: 3a4e339a-fee7-458b-934f-3adcf359d1a4

	measure '14.1 Avg Order Value' = ```
			
			    DIVIDE(
			        SUM('dwh F_Order'[SalesAmount]),
			        DISTINCTCOUNT('dwh F_Order'[OrderID]),
			        0
			    )
			```
		lineageTag: 4be300f4-f583-4f90-ba8f-85a6cbf6198b

		formatStringDefinition = pbi.CurrencyFormat()

	measure '14.2 Avg Order Value PY' =
			
			CALCULATE(
			    [14.1 Avg Order Value],
			    SAMEPERIODLASTYEAR('dwh D_Date'[Date])
			)
		lineageTag: 8ee6bb7c-d56e-42f4-b955-c8c1838e5214

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '14.3 AOV YoY %' = ```
			
			VAR _CY = [14.1 Avg Order Value]
			VAR _PY = [14.2 Avg Order Value PY]
			RETURN
			    IF(ISBLANK(_PY), BLANK(), DIVIDE(_CY - _PY, _PY)) 
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9da43237-2369-48c6-9875-3505057020d8

	measure '14.4 CF AOV YoY %' = ```
			
			    SWITCH(
			        TRUE(),
			        [14.3 AOV YoY %] > 0, pbi.ThemeColor("pos"),
			        [14.3 AOV YoY %] < 0, pbi.ThemeColor("neg"),
