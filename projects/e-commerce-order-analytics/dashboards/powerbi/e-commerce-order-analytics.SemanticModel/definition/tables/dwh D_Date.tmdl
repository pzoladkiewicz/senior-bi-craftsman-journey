	column DateModern =
			
			VAR _CY = YEAR(TODAY())
			VAR _YearOffset = _CY - 2017
			VAR _Result = DATE('dwh D_Date'[Year] + _YearOffset, 'dwh D_Date'[Month], 'dwh D_Date'[DayOfMonth])
			RETURN
			    _Result
		formatString: Long Date
		lineageTag: 1130261f-9d60-4af5-877a-0761cf3f32ae
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

