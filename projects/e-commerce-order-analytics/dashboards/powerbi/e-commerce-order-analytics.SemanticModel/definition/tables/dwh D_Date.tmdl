		lineageTag: 3a31b7ad-af2a-4afa-a32d-a0ac660088d6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'YTD Only' = IF ( 'dwh D_Date'[DateModern] <= TODAY(), 1, 0 )
		formatString: 0
