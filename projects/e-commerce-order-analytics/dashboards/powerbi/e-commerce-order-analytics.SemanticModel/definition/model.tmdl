model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pl-PL
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["dwh v_Customer_CLV","dwh v_Customer_Segments","dwh v_Geography_Performance","dwh v_Order_TimeSeries","dwh v_Product_Performance","dwh v_Shipping_KPI","dwh D_Date"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'dwh v_Customer_CLV'
ref table 'dwh v_Customer_Segments'
ref table 'dwh v_Geography_Performance'
ref table 'dwh v_Order_TimeSeries'
ref table 'dwh v_Product_Performance'
ref table 'dwh v_Shipping_KPI'
ref table 'dwh D_Date'

ref cultureInfo en-US

