DEFINE
FUNCTION
pbi.ThemeColor = (
	ThemeColorNr : scalar val
) =>
SWITCH(
	ThemeColorNr,
		1, "#3498DB", 
		2, "#27AE60", 
		3, "#E74C3C", 
		4, "#F1C40F", 
		5, "#8E44AD", 
		6, "#34495E", 
		7, "#16A085", 
		8, "#D35400",
		9, "#2C3E50",
		10, "#FFFFFF",
		"neg", "#E74C3C ",
		"pos", "#27AE60"
	)