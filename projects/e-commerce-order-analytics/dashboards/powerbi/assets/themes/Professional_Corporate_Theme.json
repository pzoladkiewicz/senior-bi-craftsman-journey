{
	"name": "Professional Corporate Theme",
	"dataColors": [
		"#3498DB", 
		"#27AE60", 
		"#E74C3C", 
		"#F1C40F", 
		"#8E44AD", 
		"#34495E", 
		"#16A085", 
		"#D35400"
	],
	"background": "#FFFFFF",
	"foreground": "#2C3E50",
	"tableAccent": "#2C3E50",
	"visualStyles": {
		"*": {
			"*": {
				"*": [
					{
						"responsive": true,
						"fontFamily": "Segoe UI"
					}
				],
				"title": [
					{
						"show": true,
						"fontColor": { "solid": { "color": "#2C3E50" } },
						"background": { "solid": { "color": "#FFFFFF" } },
						"alignment": "left",
						"fontSize": 12,
						"fontFamily": "Segoe UI Semibold"
					}
				],
				"background": [
					{
						"show": true,
						"color": { "solid": { "color": "#FFFFFF" } },
						"transparency": 0
					}
				],
				"border": [
					{
						"show": true,
						"color": { "solid": { "color": "#DCE1E6" } },
						"radius": 10
					}
				],
				"dropShadow": [
					{
						"show": true,
						"color": { "solid": { "color": "#000000" } },
						"position": "Outer",
						"preset": "BottomRight",
						"transparency": 85,
						"blur": 10
					}
				]
			}
		},
		"page": {
			"*": {
				"background": [
					{
						"color": { "solid": { "color": "#F4F6F7" } },
						"transparency": 0
					}
				]
			}
		}
	}
}
